def is_allowed_registration_email(email: str) -> bool:
    """True, если домен почты входит в список разрешённых для регистрации."""
    domain = email.rsplit("@", 1)[-1].strip().lower()
    return domain in ALLOWED_REGISTRATION_EMAIL_DOMAINS

