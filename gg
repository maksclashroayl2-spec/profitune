            if user.tutor_status == "pending":
                return redirect(url_for("tutor_moderation"))

            if user.tutor_status == "blocked":
                flash("Доступ к функциям репетитора ограничен администратором.", "warning")
                return redirect(url_for("index"))

            feature_allowed = {
                "edit_profile": user.can_edit_profile,
                "bookings": user.can_receive_bookings,
            }.get(feature, False)

            if not feature_allowed:
                flash("Эта функция пока не открыта администратором.", "warning")
                return redirect(url_for("tutor_moderation"))

            return view(*args, **kwargs)

        return wrapped

    return decorator


def sync_tutor_access(user: User) -> None:
    if user.role != "tutor":
        user.tutor_status = "approved"
        user.can_edit_profile = True
        user.can_receive_bookings = True
        user.can_be_visible = True
        return

    if user.tutor_status not in ("pending", "approved", "blocked"):
        user.tutor_status = "pending"

    if user.tutor_status != "approved":
        user.can_edit_profile = False
        user.can_receive_bookings = False
        user.can_be_visible = False


def migrate_schema() -> None:
    """Мягкая миграция старой структуры к новой роли parent."""
    inspector = inspect(db.engine)
    user_columns = {column["name"] for column in inspector.get_columns("users")}

    migrations = []

    if "tutor_status" not in user_columns:
        migrations.append("ALTER TABLE users ADD COLUMN tutor_status VARCHAR(20) DEFAULT 'approved'")

    if "can_edit_profile" not in user_columns:
        migrations.append("ALTER TABLE users ADD COLUMN can_edit_profile BOOLEAN DEFAULT 1")

    if "can_receive_bookings" not in user_columns:
        migrations.append("ALTER TABLE users ADD COLUMN can_receive_bookings BOOLEAN DEFAULT 1")

    if "can_be_visible" not in user_columns:
        migrations.append("ALTER TABLE users ADD COLUMN can_be_visible BOOLEAN DEFAULT 1")

    if "is_hidden" not in user_columns:
        migrations.append("ALTER TABLE users ADD COLUMN is_hidden BOOLEAN DEFAULT 0")

    if "admin_owner_id" not in user_columns:
        migrations.append("ALTER TABLE users ADD COLUMN admin_owner_id INTEGER")

    if "admin_owner_key" not in user_columns:
        migrations.append("ALTER TABLE users ADD COLUMN admin_owner_key VARCHAR(20)")

    if "telegram_chat_id" not in user_columns:
        migrations.append("ALTER TABLE users ADD COLUMN telegram_chat_id VARCHAR(40)")

    if "telegram_link_code" not in user_columns:
        migrations.append("ALTER TABLE users ADD COLUMN telegram_link_code VARCHAR(20)")

    if "email_verified" not in user_columns:
        # DEFAULT 1 — все уже существующие аккаунты сразу считаются
        # подтверждёнными, требование кода касается только новых регистраций.
        migrations.append("ALTER TABLE users ADD COLUMN email_verified BOOLEAN DEFAULT 1")

    if "email_verification_code" not in user_columns:
        migrations.append("ALTER TABLE users ADD COLUMN email_verification_code VARCHAR(10)")

    if "email_verification_expires" not in user_columns:
        migrations.append("ALTER TABLE users ADD COLUMN email_verification_expires DATETIME")

    if "email_verification_sent_at" not in user_columns:
        migrations.append("ALTER TABLE users ADD COLUMN email_verification_sent_at DATETIME")

    if "offer_accepted_at" not in user_columns:
        migrations.append("ALTER TABLE users ADD COLUMN offer_accepted_at DATETIME")

    if "pdn_consent_at" not in user_columns:
        migrations.append("ALTER TABLE users ADD COLUMN pdn_consent_at DATETIME")

    for query in migrations:
        db.session.execute(text(query))

    old_parent_role = "stu" + "dent"
    old_parent_column = old_parent_role + "_id"

    # Перенос старой таблицы заявок к новой структуре.
    # В прошлой версии в БД было обязательное поле student_id.
    # Если просто добавить parent_id, SQLite всё равно требует student_id
    # при создании новой заявки. Поэтому таблица пересоздаётся полностью.
    table_names = inspector.get_table_names()
    if "bookings" in table_names:
        booking_columns = {column["name"] for column in inspector.get_columns("bookings")}

        if "parent_id" not in booking_columns:
            db.session.execute(text("ALTER TABLE bookings ADD COLUMN parent_id INTEGER"))
            booking_columns.add("parent_id")

        if old_parent_column in booking_columns:
            db.session.execute(
                text(f"UPDATE bookings SET parent_id = {old_parent_column} WHERE parent_id IS NULL")
            )

            db.session.execute(text("DROP TABLE IF EXISTS bookings_parent_migration"))
            db.session.execute(text("""
                CREATE TABLE bookings_parent_migration (
                    id INTEGER NOT NULL PRIMARY KEY,
                    parent_id INTEGER NOT NULL,
                    tutor_id INTEGER NOT NULL,
                    lesson_date VARCHAR(20) NOT NULL,
                    lesson_time VARCHAR(20) NOT NULL,
                    comment TEXT,
                    status VARCHAR(20),
                    created_at DATETIME,
                    FOREIGN KEY(parent_id) REFERENCES users (id),
                    FOREIGN KEY(tutor_id) REFERENCES users (id)
                )
            """))
            db.session.execute(text(f"""
                INSERT INTO bookings_parent_migration
                    (id, parent_id, tutor_id, lesson_date, lesson_time, comment, status, created_at)
                SELECT
                    id,
                    COALESCE(parent_id, {old_parent_column}),
                    tutor_id,
                    lesson_date,
                    lesson_time,
                    comment,
                    status,
                    created_at
                FROM bookings
                WHERE COALESCE(parent_id, {old_parent_column}) IS NOT NULL
            """))
            db.session.execute(text("DROP TABLE bookings"))
            db.session.execute(text("ALTER TABLE bookings_parent_migration RENAME TO bookings"))

    # parent_profiles.codename раньше создавался автоматически и был NOT NULL.
    # Теперь кодовое имя задаёт репетитор вручную, поэтому поле
    # должно спокойно быть пустым до первого назначения репетитора.
    table_names = inspector.get_table_names()
    if "parent_profiles" in table_names:
        parent_profile_columns_info = inspector.get_columns("parent_profiles")
        codename_info = next(
            (column for column in parent_profile_columns_info if column["name"] == "codename"),
            None,
        )
        if codename_info and not codename_info.get("nullable", True):
            db.session.execute(text("DROP TABLE IF EXISTS parent_profiles_manual_migration"))
            db.session.execute(text("""
                CREATE TABLE parent_profiles_manual_migration (
                    id INTEGER NOT NULL PRIMARY KEY,
                    user_id INTEGER NOT NULL UNIQUE,
                    codename VARCHAR(120) UNIQUE,
                    FOREIGN KEY(user_id) REFERENCES users (id)
                )
            """))
            db.session.execute(text("""
                INSERT INTO parent_profiles_manual_migration (id, user_id, codename)
                SELECT id, user_id, codename FROM parent_profiles
            """))
            db.session.execute(text("DROP TABLE parent_profiles"))
            db.session.execute(text("ALTER TABLE parent_profiles_manual_migration RENAME TO parent_profiles"))

    # Поля недель для периодов и статуса оплаты.
    if "weeks" in table_names:
        week_columns = {column["name"] for column in inspector.get_columns("weeks")}
        if "payment_status" not in week_columns:
            db.session.execute(text("ALTER TABLE weeks ADD COLUMN payment_status VARCHAR(30) DEFAULT 'unpaid'"))
        if "date_start" not in week_columns:
            db.session.execute(text("ALTER TABLE weeks ADD COLUMN date_start VARCHAR(20) DEFAULT ''"))
        if "date_end" not in week_columns:
            db.session.execute(text("ALTER TABLE weeks ADD COLUMN date_end VARCHAR(20) DEFAULT ''"))
        if "receipt_not_required" not in week_columns:
            db.session.execute(text("ALTER TABLE weeks ADD COLUMN receipt_not_required BOOLEAN DEFAULT 0"))

    # Стоимость часа для родителя у пары родитель + репетитор.
    if "tutor_assignments" in table_names:
        tutor_assignment_columns = {column["name"] for column in inspector.get_columns("tutor_assignments")}
        if "parent_hour_price" not in tutor_assignment_columns:
            db.session.execute(text("ALTER TABLE tutor_assignments ADD COLUMN parent_hour_price FLOAT DEFAULT 0"))

    # Ставка репетитора в личном списке основного репетитора.
    if "hidden_tutor_pool" in table_names:
        pool_columns = {column["name"] for column in inspector.get_columns("hidden_tutor_pool")}
        if "hidden_hour_rate" not in pool_columns:
            db.session.execute(text("ALTER TABLE hidden_tutor_pool ADD COLUMN hidden_hour_rate FLOAT DEFAULT 0"))
        if "rate_mode" not in pool_columns:
            db.session.execute(text("ALTER TABLE hidden_tutor_pool ADD COLUMN rate_mode VARCHAR(20) DEFAULT 'manual'"))

    # Процент обычного репетитора от оплат его родителей.
    if "tutor_profiles" in table_names:
        tutor_profile_columns = {column["name"] for column in inspector.get_columns("tutor_profiles")}
        if "profit_percent" not in tutor_profile_columns:
            db.session.execute(text("ALTER TABLE tutor_profiles ADD COLUMN profit_percent FLOAT DEFAULT 0"))

    # Поля модерации для недельных отчётов.
    if "weekly_reports" in table_names:
        report_columns = {column["name"] for column in inspector.get_columns("weekly_reports")}
        report_migrations = {
            "pending_text": "ALTER TABLE weekly_reports ADD COLUMN pending_text TEXT DEFAULT ''",
            "pending_grade": "ALTER TABLE weekly_reports ADD COLUMN pending_grade VARCHAR(50) DEFAULT ''",
            "hours": "ALTER TABLE weekly_reports ADD COLUMN hours FLOAT DEFAULT 0",
            "pending_hours": "ALTER TABLE weekly_reports ADD COLUMN pending_hours FLOAT DEFAULT 0",
            "moderation_status": "ALTER TABLE weekly_reports ADD COLUMN moderation_status VARCHAR(30) DEFAULT 'draft'",
            "moderation_comment": "ALTER TABLE weekly_reports ADD COLUMN moderation_comment TEXT DEFAULT ''",
            "submitted_by_hidden_tutor_id": "ALTER TABLE weekly_reports ADD COLUMN submitted_by_hidden_tutor_id INTEGER",
            "reviewed_by_id": "ALTER TABLE weekly_reports ADD COLUMN reviewed_by_id INTEGER",
            "submitted_at": "ALTER TABLE weekly_reports ADD COLUMN submitted_at DATETIME",
            "reviewed_at": "ALTER TABLE weekly_reports ADD COLUMN reviewed_at DATETIME",
            "parent_seen_at": "ALTER TABLE weekly_reports ADD COLUMN parent_seen_at DATETIME",
            "hidden_seen_at": "ALTER TABLE weekly_reports ADD COLUMN hidden_seen_at DATETIME",
            "parent_reject_reason": "ALTER TABLE weekly_reports ADD COLUMN parent_reject_reason TEXT DEFAULT ''",
            "parent_rejected_at": "ALTER TABLE weekly_reports ADD COLUMN parent_rejected_at DATETIME",
        }
        for column_name, query in report_migrations.items():
            if column_name not in report_columns:
                db.session.execute(text(query))


    # Таблица уведомлений для бейджей в меню.
    if "notifications" not in table_names:
        db.session.execute(text("""
            CREATE TABLE notifications (
                id INTEGER NOT NULL PRIMARY KEY,
                user_id INTEGER NOT NULL,
                type VARCHAR(50) NOT NULL,
                entity_type VARCHAR(50),
                entity_id INTEGER,
                title VARCHAR(255),
                link VARCHAR(255),
                is_read BOOLEAN DEFAULT 0,
                created_at DATETIME,
                read_at DATETIME,
                FOREIGN KEY(user_id) REFERENCES users (id)
            )
        """))
    else:
        notification_columns = {column["name"] for column in inspector.get_columns("notifications")}
        notification_migrations = {
            "entity_type": "ALTER TABLE notifications ADD COLUMN entity_type VARCHAR(50)",
            "entity_id": "ALTER TABLE notifications ADD COLUMN entity_id INTEGER",
            "title": "ALTER TABLE notifications ADD COLUMN title VARCHAR(255)",
            "link": "ALTER TABLE notifications ADD COLUMN link VARCHAR(255)",
            "is_read": "ALTER TABLE notifications ADD COLUMN is_read BOOLEAN DEFAULT 0",
            "created_at": "ALTER TABLE notifications ADD COLUMN created_at DATETIME",
            "read_at": "ALTER TABLE notifications ADD COLUMN read_at DATETIME",
        }
        for column_name, query in notification_migrations.items():
            if column_name not in notification_columns:
                db.session.execute(text(query))

    # parent_profiles.codename должен разрешать одинаковые кодовые имена.
    # SQLite не умеет просто DROP UNIQUE, поэтому пересоздаём таблицу без UNIQUE.
    table_names = inspector.get_table_names()
    if "parent_profiles" in table_names:
        db.session.execute(text("DROP TABLE IF EXISTS parent_profiles_no_unique_migration"))
        db.session.execute(text("""
            CREATE TABLE parent_profiles_no_unique_migration (
                id INTEGER NOT NULL PRIMARY KEY,
                user_id INTEGER NOT NULL UNIQUE,
                codename VARCHAR(120),
                FOREIGN KEY(user_id) REFERENCES users (id)
            )
        """))
        db.session.execute(text("""
            INSERT INTO parent_profiles_no_unique_migration (id, user_id, codename)
            SELECT id, user_id, codename FROM parent_profiles
        """))
        db.session.execute(text("DROP TABLE parent_profiles"))
        db.session.execute(text("ALTER TABLE parent_profiles_no_unique_migration RENAME TO parent_profiles"))

    # Старые пользователи переводятся на роль parent.
    db.session.execute(text("UPDATE users SET role = 'parent' WHERE role = :old_role"), {"old_role": old_parent_role})
    db.session.commit()

    for user in User.query.all():
        if user.role == "parent":
            get_or_create_parent_profile(user)

        if user.role != "tutor":
            user.tutor_status = "approved"
            user.can_edit_profile = True
            user.can_receive_bookings = True
            user.can_be_visible = True
            user.is_hidden = False
            user.admin_owner_id = None
            user.admin_owner_key = None
        elif not user.tutor_status:
            user.tutor_status = "approved"

    db.session.commit()


