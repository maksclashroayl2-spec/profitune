def migrate_legacy_report_uploads() -> None:
    """Переносит вложения отчётов из старой публичной папки в защищённую.

    До этого исправления файлы лежали в static/uploads/reports и были
    доступны всем по прямой ссылке. Если там остались файлы — переносим
    их на новое место при первом запуске после обновления, ничего
    не удаляя и не перезаписывая существующее.
    """
    if not os.path.isdir(LEGACY_REPORT_UPLOAD_DIR):
        return

    moved = 0
    for filename in os.listdir(LEGACY_REPORT_UPLOAD_DIR):
        old_path = os.path.join(LEGACY_REPORT_UPLOAD_DIR, filename)
        new_path = os.path.join(REPORT_UPLOAD_DIR, filename)
        if os.path.isfile(old_path) and not os.path.exists(new_path):
            shutil.move(old_path, new_path)
            moved += 1

    if moved:
        print(f"Перенесено вложений в защищённую папку: {moved}")


