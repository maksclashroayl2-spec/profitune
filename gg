def notification_group(notification_type: str) -> Optional[str]:
    """Куда показывать уведомление в верхнем меню."""
    if notification_type in ("parent_new_report", "parent_payment_result"):
        return "parent_lessons"

    if notification_type in ("visible_receipt_uploaded", "visible_hidden_report_pending", "visible_parent_report_rejected"):
        return "visible_reports"

    if notification_type == "hidden_report_reviewed":
        return "hidden_reports"

