@app.route("/tutor/hidden-assignments", methods=["GET", "POST"])
@login_required
@role_required("tutor")
def manage_hidden_assignments():
    """Назначение репетитора родителю.

    Нерепетитор сам выбирает родителя, вручную задаёт ему кодовое
    имя и назначает репетитора. Родитель это кодовое имя не видит.
    """
    user = current_user()

    if user.is_hidden:
        flash("Репетитор не может назначать других репетиторов.", "error")
        return redirect(url_for("hidden_reports"))

    if request.method == "POST":
        parent_id = request.form.get("parent_id", type=int)
        codename = request.form.get("codename", "").strip()
        hidden_tutor_id = request.form.get("hidden_tutor_id", type=int)
        parent_hour_price = parse_float(request.form.get("parent_hour_price", 0))

        parent = db.session.get(User, parent_id) if parent_id else None
        hidden_tutor = db.session.get(User, hidden_tutor_id) if hidden_tutor_id else None

        if not parent or parent.role != "parent" or not parent_has_visible_tutor(parent.id, user.id):
            flash("Выберите родителя из вашего списка.", "error")
            return redirect(url_for("manage_hidden_assignments"))

        parent_assignment = TutorAssignment.query.filter_by(
            parent_id=parent.id,
            tutor_id=user.id,
        ).first()
        if parent_assignment:
            old_price = parse_float(parent_assignment.parent_hour_price)
            if round(old_price, 6) != round(parent_hour_price, 6):
                log_finance_change(
                    f"Цена часа для родителя: {parent.name}",
                    format_money(old_price) + "/ч",
                    format_money(parent_hour_price) + "/ч",
                )
            parent_assignment.parent_hour_price = parent_hour_price

        parent_profile = get_or_create_parent_profile(parent)
        ok, message = set_parent_codename(parent_profile, codename)
        if not ok:
            flash(message, "error")
            return redirect(url_for("manage_hidden_assignments"))

        if not hidden_tutor or hidden_tutor.role != "tutor" or not hidden_tutor.is_hidden:
            flash("Выберите корректного репетитора.", "warning")
            return redirect(url_for("manage_hidden_assignments"))

        allowed_in_pool = HiddenTutorPool.query.filter_by(
            visible_tutor_id=user.id,
            hidden_tutor_id=hidden_tutor.id,
        ).first()

        if not allowed_in_pool:
            flash("Сначала добавьте этого репетитора в список «Мои репетиторы».", "warning")
            return redirect(url_for("manage_hidden_assignments"))

        existing = HiddenTutorAssignment.query.filter_by(
            parent_id=parent.id,
            visible_tutor_id=user.id,
            hidden_tutor_id=hidden_tutor.id,
        ).first()

        if existing:
            existing.parent_codename = codename
        else:
            db.session.add(
                HiddenTutorAssignment(
                    parent_id=parent.id,
                    visible_tutor_id=user.id,
                    hidden_tutor_id=hidden_tutor.id,
                    parent_codename=codename,
                )
            )

        ensure_default_weeks(parent.id, user.id)
        db.session.commit()

        flash("Кодовое имя сохранено, репетитор назначен родителю.", "success")
        return redirect(url_for("manage_hidden_assignments"))

    parent_assignments = TutorAssignment.query.filter_by(tutor_id=user.id).all()

    assigned_parent_ids = {
        item.parent_id
        for item in HiddenTutorAssignment.query.filter_by(visible_tutor_id=user.id).all()
    }

    parent_assignments = [
        assignment for assignment in parent_assignments
        if assignment.parent_id not in assigned_parent_ids
    ]

    for assignment in parent_assignments:
        get_or_create_parent_profile(assignment.parent)

    my_hidden_tutors = (
        HiddenTutorPool.query
        .filter_by(visible_tutor_id=user.id)
        .order_by(HiddenTutorPool.id.asc())
        .all()
    )

    busy_ids = [item.hidden_tutor_id for item in HiddenTutorPool.query.all()]

    available_hidden_tutors = (
        User.query
        .filter(User.role == "tutor", User.is_hidden.is_(True))
        .filter(~User.id.in_(busy_ids) if busy_ids else True)
        .order_by(User.name.asc())
        .all()
    )

    my_hidden_tutor_ids = [item.hidden_tutor_id for item in my_hidden_tutors]
    assignment_hidden_tutors = (
        User.query
        .filter(User.id.in_(my_hidden_tutor_ids))
        .order_by(User.name.asc())
        .all()
        if my_hidden_tutor_ids
        else []
    )

    hidden_assignments = HiddenTutorAssignment.query.filter_by(visible_tutor_id=user.id).all()

    grouped_hidden_assignments = {}
    for assignment in hidden_assignments:
        tutor_id = assignment.hidden_tutor_id
        if tutor_id not in grouped_hidden_assignments:
            grouped_hidden_assignments[tutor_id] = {
                "tutor": assignment.hidden_tutor,
                "assignments": [],
            }
        grouped_hidden_assignments[tutor_id]["assignments"].append(assignment)

    return render_template(
        "manage_hidden_assignments.html",
        title="Репетиторы",
        parent_assignments=parent_assignments,
        available_hidden_tutors=available_hidden_tutors,
        assignment_hidden_tutors=assignment_hidden_tutors,
        hidden_assignments=hidden_assignments,
        my_hidden_tutors=my_hidden_tutors,
        grouped_hidden_assignments=grouped_hidden_assignments.values(),
    )


