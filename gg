def get_or_create_week(parent_id: int, tutor_id: int, number: int) -> Week:
    """Берёт неделю из БД или создаёт её вместе с пустым отчётом."""
    week = Week.query.filter_by(parent_id=parent_id, tutor_id=tutor_id, number=number).first()
    if not week:
        date_start, date_end = get_default_week_dates(number)
        week = Week(
            parent_id=parent_id,
            tutor_id=tutor_id,
            number=number,
            date_start=date_start,
            date_end=date_end,
            payment_status="unpaid",
        )
        db.session.add(week)
        db.session.flush()
    elif not week.date_start or not week.date_end:
        week.date_start, week.date_end = get_default_week_dates(number)

    get_or_create_report(week)

    db.session.commit()
    return week


def ensure_default_weeks(parent_id: int, tutor_id: int, total: int = 1) -> list[Week]:
    """Создаёт стандартный список недель для пары родитель + репетитор."""
