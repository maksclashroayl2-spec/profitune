# secret_key больше не хранится в коде. В переменных окружения задаётся
# SECRET_KEY — длинная случайная строка (например: python -c "import secrets;
# print(secrets.token_hex(32))"). Если её не задать, при каждом перезапуске
# сервера будет генерироваться новый случайный ключ — это работает, но
# разлогинивает всех пользователей при перезапуске, поэтому в бою
# переменную нужно задать один раз и не менять.
app.secret_key = os.environ.get("SECRET_KEY") or secrets.token_hex(32)

# CSRF-защита всех форм. Раньше её не было вообще — POST-формы (смена
# пароля, финансовые настройки, удаление пользователей) были уязвимы
# к межсайтовой подделке запроса. csrf_field() ниже — то, что вставлено
# в каждую POST-форму во всех шаблонах ({{ csrf_field() }}).
csrf = CSRFProtect(app)


@app.context_processor
def inject_csrf_field():
    def csrf_field():
        return Markup(f'<input type="hidden" name="csrf_token" value="{generate_csrf()}">')
    return dict(csrf_field=csrf_field)


