def get_weeks_for_pair(parent_id: int, tutor_id: int) -> list[Week]:
    """Возвращает все созданные отчётные недели для пары родитель + репетитор.

    Важно: эта функция НЕ создаёт недели автоматически. Новые недели
    теперь создаёт репетитор кнопкой «Создать отчётную неделю».
    """
    weeks = (
        Week.query.filter_by(parent_id=parent_id, tutor_id=tutor_id)
        .order_by(Week.number.asc())
        .all()
    )

    changed = False
    for week in weeks:
        if not week.date_start or not week.date_end:
            week.date_start, week.date_end = get_default_week_dates(week.number)
            changed = True
        if not WeeklyReport.query.filter_by(week_id=week.id).first():
            get_or_create_report(week)
            changed = True

    if changed:
        db.session.commit()

    return weeks


def remove_empty_extra_weeks() -> None:
    """Оставляет по одной стартовой неделе для пары родитель + репетитор.

    Раньше проект автоматически создавал сразу 8 недель. Теперь стартовая
    неделя должна быть одна, а остальные создаются кнопкой основного
    репетитора. Чтобы не удалить реальные данные, функция удаляет только
    пустые дополнительные недели: без текста, оценки, черновика, чеков и
    подтверждённой оплаты.
    """
    pairs = {(week.parent_id, week.tutor_id) for week in Week.query.all()}

    for parent_id, tutor_id in pairs:
        weeks = (
            Week.query.filter_by(parent_id=parent_id, tutor_id=tutor_id)
            .order_by(Week.number.asc(), Week.id.asc())
            .all()
        )

        if len(weeks) <= 1:
            continue

        # Первую неделю оставляем всегда. Остальные удаляем только если они пустые.
        for week in weeks[1:]:
            report = week.report
            has_report_text = bool(
                report and (
                    report.text
                    or report.grade
                    or report.pending_text
                    or report.pending_grade
                    or parse_float(getattr(report, "hours", 0))
                    or parse_float(getattr(report, "pending_hours", 0))
                )
            )
            has_files = bool(report and report.attachments)
            has_payment = week.payment_status not in (None, "", "unpaid")

            if has_report_text or has_files or has_payment:
                continue

            db.session.delete(week)

    db.session.commit()


def get_next_week_dates(parent_id: int, tutor_id: int, number: int) -> tuple[str, str]:
    """Считает даты для новой отчётной недели.

    Если у прошлой недели есть date_end, новая начинается на следующий день.
    Если дат нет, используется стандартный расчёт от текущей недели.
    """
    previous_week = (
        Week.query.filter_by(parent_id=parent_id, tutor_id=tutor_id)
        .order_by(Week.number.desc())
        .first()
    )

    if previous_week and previous_week.date_end:
        try:
            start = datetime.strptime(previous_week.date_end, "%Y-%m-%d").date() + timedelta(days=1)
            end = start + timedelta(days=6)
            return start.isoformat(), end.isoformat()
        except ValueError:
            pass

    return get_default_week_dates(number)

