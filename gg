def create_notification(
    user_id: Optional[int],
    notification_type: str,
    title: str,
    link: str = "",
    entity_type: str = "week",
    entity_id: Optional[int] = None,
) -> None:
    """Создаёт уведомление без дублей для одного и того же события."""
    if not user_id:
        return

    existing = Notification.query.filter_by(
        user_id=user_id,
        type=notification_type,
        entity_type=entity_type,
        entity_id=entity_id,
        is_read=False,
    ).first()

    if existing:
        existing.title = title
        existing.link = link
        existing.created_at = datetime.utcnow()
        return

    db.session.add(
        Notification(
            user_id=user_id,
            type=notification_type,
            entity_type=entity_type,
            entity_id=entity_id,
            title=title,
            link=link,
            is_read=False,
        )
    )


def mark_notifications_read(
    user_id: Optional[int],
    notification_types: list[str],
    entity_type: Optional[str] = None,
    entity_id: Optional[int] = None,
) -> None:
    """Помечает уведомления прочитанными при открытии нужной страницы."""
    if not user_id or not notification_types:
        return

    query = Notification.query.filter(
        Notification.user_id == user_id,
        Notification.is_read == False,  # noqa: E712
        Notification.type.in_(notification_types),
    )

    if entity_type is not None:
        query = query.filter(Notification.entity_type == entity_type)
    if entity_id is not None:
        query = query.filter(Notification.entity_id == entity_id)

    changed = False
    for notification in query.all():
        notification.is_read = True
        notification.read_at = datetime.utcnow()
        changed = True

    if changed:
        db.session.commit()




def get_unread_week_notification_counts(
    user_id: Optional[int],
    notification_types: list[str],
) -> dict[int, int]:
    """Возвращает количество непрочитанных уведомлений по id недели."""
    if not user_id or not notification_types:
        return {}

    counts: dict[int, int] = {}

    try:
        notifications = Notification.query.filter(
            Notification.user_id == user_id,
            Notification.is_read == False,  # noqa: E712
            Notification.entity_type == "week",
            Notification.entity_id.isnot(None),
            Notification.type.in_(notification_types),
        ).all()

        for notification in notifications:
            counts[notification.entity_id] = counts.get(notification.entity_id, 0) + 1
    except Exception:
        return {}

    return counts


def count_unread_for_weeks(week_ids: list[int], unread_by_week: dict[int, int]) -> int:
    """Суммирует непрочитанные уведомления для списка недель."""
    return sum(unread_by_week.get(week_id, 0) for week_id in week_ids)

def get_nav_notification_counts(user: Optional[User]) -> dict:
    """Считает непрочитанные уведомления для бейджей меню."""
    counts = {
        "parent_lessons": 0,
        "visible_reports": 0,
        "hidden_reports": 0,
    }

    if not user:
        return counts

    try:
        notifications = Notification.query.filter_by(
            user_id=user.id,
            is_read=False,
        ).all()

        for notification in notifications:
            group = notification_group(notification.type)
            if group in counts:
                counts[group] += 1
    except Exception:
        return counts

    return counts

