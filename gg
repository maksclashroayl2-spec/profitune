def week_dates_for_filter(week: Week) -> tuple[Optional[date], Optional[date]]:
    start = None
    end = None

    if week.date_start:
        try:
            start = datetime.strptime(week.date_start, "%Y-%m-%d").date()
        except ValueError:
            start = None

    if week.date_end:
        try:
            end = datetime.strptime(week.date_end, "%Y-%m-%d").date()
        except ValueError:
            end = None

    return start, end


def week_intersects_period(week: Week, date_from_value: Optional[date], date_to_value: Optional[date]) -> bool:
    if not date_from_value and not date_to_value:
        return True

    week_start, week_end = week_dates_for_filter(week)

    if not week_start and not week_end:
        return False

    if not week_start:
        week_start = week_end

    if not week_end:
        week_end = week_start

    if date_from_value and week_end < date_from_value:
        return False

    if date_to_value and week_start > date_to_value:
        return False

    return True


def is_completed_paid_week(week: Week) -> bool:
    # Для финансов и зарплат считаем оплаченную неделю сразу после оплаты,
    # даже если календарно она ещё идёт. Иначе деньги есть, а интерфейс делает
    # вид, что пошёл за хлебом и не вернулся.
    week_start, week_end = week_dates_for_filter(week)
    return bool((week_start or week_end) and week.payment_status == "paid")


def latest_completed_paid_week_period() -> tuple[Optional[date], Optional[date]]:
    """Последняя оплаченная неделя для финансов и зарплат."""
    latest_start = None
    latest_end = None

    weeks = (
        Week.query
        .filter_by(payment_status="paid")
        .order_by(Week.date_start.desc(), Week.date_end.desc(), Week.number.desc(), Week.id.desc())
        .all()
    )

    for week in weeks:
        if not is_completed_paid_week(week):
            continue

        week_start, week_end = week_dates_for_filter(week)
        if not week_end:
            continue

        if latest_end is None or week_end > latest_end:
            latest_start = week_start or week_end
            latest_end = week_end

    return latest_start, latest_end


@app.route("/admin/finance")
@login_required
@role_required("admin")
def admin_finance():
    """Финансовая сводка с гибким распределением прибыли.

    Прибыль считается по нескрытому репетитору так:
    доход родителей - выплаты скрытым репетиторам = база распределения.
    Дальше база делится между выбранными получателями: админами и
    нескрытыми репетиторами. Наконец-то не таблица длиной в человеческое
    разочарование, а нормальная схема денег.
    """
    date_from = request.args.get("date_from", "").strip()
    date_to = request.args.get("date_to", "").strip()

    def parse_date_filter(value: str) -> Optional[date]:
        if not value:
            return None
        try:
            return datetime.strptime(value, "%Y-%m-%d").date()
        except ValueError:
            return None

    custom_period_selected = bool(date_from or date_to)
    filter_from = parse_date_filter(date_from)
    filter_to = parse_date_filter(date_to)

    if date_from and not filter_from:
        flash("Некорректная дата начала периода.", "warning")
        return redirect(url_for("admin_finance"))

    if date_to and not filter_to:
        flash("Некорректная дата окончания периода.", "warning")
        return redirect(url_for("admin_finance"))

    if filter_from and filter_to and filter_from > filter_to:
        flash("Дата начала не может быть позже даты окончания.", "warning")
        return redirect(url_for("admin_finance"))

    # По умолчанию показываем не весь исторический склад денег, а последнюю
    # завершённую оплаченную неделю. Остальное можно выбрать руками фильтром.
    if not custom_period_selected:
        filter_from, filter_to = latest_completed_paid_week_period()
        date_from = filter_from.isoformat() if filter_from else ""
        date_to = filter_to.isoformat() if filter_to else ""

    period_caption = (
        "Последняя оплаченная неделя"
        if not custom_period_selected
        else "Выбранный период"
    )

    all_visible_tutors = (
        User.query
        .filter_by(role="tutor", is_hidden=False)
        .order_by(User.name.asc())
        .all()
    )
    all_hidden_tutors = (
        User.query
        .filter_by(role="tutor", is_hidden=True)
        .order_by(User.name.asc())
        .all()
    )

    # В распределении прибыли под админами в проекте подразумеваются
    # рабочие получатели: Саня, Серый и Дэн. Не показываем техническую
    # учетку "Администратор", потому что она человеку в интерфейсе нужна
    # примерно как чайнику диплом по философии.
    recipients = [
        {"id": "admin_sanya", "name": "Саня", "role": "Админ", "is_admin": True},
        {"id": "admin_seriy", "name": "Серый", "role": "Админ", "is_admin": True},
        {"id": "admin_den", "name": "Дэн", "role": "Админ", "is_admin": True},
    ]

    used_recipient_ids = {item["id"] for item in recipients}
    for user in all_visible_tutors:
        recipient_id = str(user.id)
        if recipient_id in used_recipient_ids:
            continue
        used_recipient_ids.add(recipient_id)
        recipients.append({
            "id": recipient_id,
            "name": user.name,
            "role": "Нескрытый репетитор",
            "is_admin": False,
            "is_hidden_recipient": False,
        })

    for user in all_hidden_tutors:
        recipient_id = str(user.id)
        if recipient_id in used_recipient_ids:
            continue
        used_recipient_ids.add(recipient_id)
        recipients.append({
            "id": recipient_id,
            "name": user.name,
            "role": "Скрытый репетитор",
            "is_admin": False,
            "is_hidden_recipient": True,
        })

    recipient_ids = [item["id"] for item in recipients]
    admin_sources = [
        {"id": "admin_sanya", "name": "Саня", "role": "Админ", "is_admin": True},
        {"id": "admin_seriy", "name": "Серый", "role": "Админ", "is_admin": True},
        {"id": "admin_den", "name": "Дэн", "role": "Админ", "is_admin": True},
    ]
    profit_sources = admin_sources + [
        {"id": str(user.id), "name": user.name, "role": "Нескрытый репетитор", "is_admin": False, "user": user}
        for user in all_visible_tutors
    ]

    def share_key(source_id: str, recipient_id: str) -> str:
        return f"profit_share_{source_id}_{recipient_id}"

    def load_distribution(source_id: str) -> list[dict]:
        """Возвращает проценты распределения для админа или нескрытого репетитора."""
        rows = []
        for recipient in recipients:
            value = get_finance_setting(share_key(str(source_id), recipient["id"]), 0.0)
            rows.append({**recipient, "percent": value})
        return rows

    def source_finance_rows(period_from: Optional[date], period_to: Optional[date]) -> tuple[list[dict], dict, dict]:
        source_rows = []
        recipient_totals = {recipient["id"]: 0.0 for recipient in recipients}
        recipient_source_map = {recipient["id"]: {} for recipient in recipients}

        for visible_tutor in all_visible_tutors:
            distribution = load_distribution(str(visible_tutor.id))

            tutor_income = 0.0
            tutor_hidden_payout = 0.0
            tutor_hours = 0.0
            tutor_parent_ids = set()

            weeks = (
                Week.query
                .filter_by(tutor_id=visible_tutor.id)
                .order_by(Week.date_start.asc(), Week.number.asc(), Week.id.asc())
                .all()
            )

            for week in weeks:
                if not is_completed_paid_week(week):
                    continue
                if not week_intersects_period(week, period_from, period_to):
                    continue
                if not week.report:
                    continue

                finance = get_week_finance(week)
                hours = parse_float(finance.get("hours"))
                if hours <= 0:
                    continue

                parent_sum = parse_float(finance.get("parent_total"))
                hidden_sum = parse_float(finance.get("hidden_total"))

                tutor_income += parent_sum
                tutor_hidden_payout += hidden_sum
                tutor_hours += hours
                tutor_parent_ids.add(week.parent_id)

            tutor_tax_amount = tutor_income * PARENT_REVENUE_TAX_RATE
            # Налог 6.4% со всей суммы от родителей вычитается первым шагом.
            base_profit = (tutor_income - tutor_tax_amount) - tutor_hidden_payout
            distributed_total = 0.0
            distribution_rows = []

            for recipient in distribution:
                percent = parse_float(recipient.get("percent"))
                amount = base_profit * percent / 100
                if percent > 0 or amount > 0:
                    distribution_rows.append({**recipient, "amount": amount})
                recipient_totals[recipient["id"]] = recipient_totals.get(recipient["id"], 0.0) + amount
                distributed_total += amount

                if amount != 0 or percent > 0:
                    source_item = recipient_source_map[recipient["id"]].setdefault(visible_tutor.id, {
                        "id": visible_tutor.id,
                        "name": visible_tutor.name,
                        "parents_count": len(tutor_parent_ids),
                        "hours": tutor_hours,
                        "income": tutor_income,
                        "tax_amount": tutor_tax_amount,
                        "hidden_payout": tutor_hidden_payout,
                        "visible_percent": percent,
                        "visible_payout": amount,
                        "admin_profit": amount,
                    })
                    source_item["visible_percent"] = percent
                    source_item["visible_payout"] = amount
                    source_item["admin_profit"] = amount

            source_rows.append({
                "id": visible_tutor.id,
                "name": visible_tutor.name,
                "parents_count": len(tutor_parent_ids),
                "hours": tutor_hours,
                "income": tutor_income,
                "tax_amount": tutor_tax_amount,
                "hidden_payout": tutor_hidden_payout,
                "base_profit": base_profit,
                "distributed_total": distributed_total,
                "distribution": distribution_rows,
            })

        # Дополнительный уровень: прибыль, попавшую к Санe, Серому или Дэну,
        # можно дальше разделить между админами и нескрытыми репетиторами.
        # Считаем один понятный уровень перераспределения, без финансовой матрешки
        # и вечного цикла "Саня -> Дэн -> Саня". Люди и так достаточно стараются.
        admin_direct_totals = {source["id"]: recipient_totals.get(source["id"], 0.0) for source in admin_sources}
        for admin_source in admin_sources:
            source_id = admin_source["id"]
            base_profit = admin_direct_totals.get(source_id, 0.0)
            distribution = load_distribution(source_id)
            active_distribution = [row for row in distribution if parse_float(row.get("percent")) > 0]
            if not active_distribution:
                continue

            recipient_totals[source_id] = recipient_totals.get(source_id, 0.0) - base_profit
            distribution_rows = []
            distributed_total = 0.0

            for recipient in active_distribution:
                percent = parse_float(recipient.get("percent"))
                amount = base_profit * percent / 100
                recipient_totals[recipient["id"]] = recipient_totals.get(recipient["id"], 0.0) + amount
                distributed_total += amount
                distribution_rows.append({**recipient, "amount": amount})

                source_item = recipient_source_map[recipient["id"]].setdefault(source_id, {
                    "id": source_id,
                    "name": admin_source["name"],
                    "parents_count": 0,
                    "hours": 0.0,
                    "income": base_profit,
                    "hidden_payout": 0.0,
                    "visible_percent": percent,
                    "visible_payout": amount,
                    "admin_profit": amount,
                })
                source_item["visible_percent"] = percent
                source_item["visible_payout"] = amount
                source_item["admin_profit"] = amount

            source_rows.append({
                "id": source_id,
                "name": admin_source["name"],
                "parents_count": 0,
                "hours": 0.0,
                "income": base_profit,
                "hidden_payout": 0.0,
                "base_profit": base_profit,
                "distributed_total": distributed_total,
                "distribution": distribution_rows,
                "is_admin_source": True,
            })

        return source_rows, recipient_totals, recipient_source_map

    source_rows, recipient_totals, recipient_source_map = source_finance_rows(filter_from, filter_to)

    total_account = sum(row["income"] for row in source_rows)
    total_hidden_payout = sum(row["hidden_payout"] for row in source_rows)
    total_visible_payout = sum(
        amount for recipient_id, amount in recipient_totals.items()
        if any(r["id"] == recipient_id and not r["is_admin"] for r in recipients)
    )
    total_admin_sum = sum(
        amount for recipient_id, amount in recipient_totals.items()
        if any(r["id"] == recipient_id and r["is_admin"] for r in recipients)
    )

    # В разделе «Финансы школы» показываем только трех людей, которых реально
    # надо просматривать: Саня, Серый и Дэн. Нескрытые репетиторы остаются
    # участниками распределения и источниками прибыли, но не превращают эту
    # страницу в унылую простыню карточек. Маленькая победа над хаосом.
    finance_view_recipients = [recipient for recipient in recipients if recipient.get("is_admin")]

    admin_cards = []
    for recipient in finance_view_recipients:
        rows = list(recipient_source_map.get(recipient["id"], {}).values())
        rows = [
            row for row in rows
            if parse_float(row.get("visible_payout")) != 0 or parse_float(row.get("visible_percent")) > 0
        ]
        profit = recipient_totals.get(recipient["id"], 0.0)
        admin_cards.append({
            "name": recipient["name"],
            "role": recipient["role"],
            "parent_income": sum(row.get("income", 0.0) for row in rows),
            "hidden_payout": sum(row.get("hidden_payout", 0.0) for row in rows),
            "visible_payout": profit,
            "branch_profit": profit,
            "bonus_to_seriy": 0.0,
            "bonus_from_others": 0.0,
            "bonus_items": [],
            "profit": profit,
            "hours": sum(row.get("hours", 0.0) for row in rows),
            "visible_count": len(rows),
            "visible_tutor_rows": rows,
        })

    def chart_for_period(period_from: Optional[date], period_to: Optional[date]) -> list[dict]:
        _, totals, _ = source_finance_rows(period_from, period_to)
        return [
            {"name": recipient["name"], "profit": round(totals.get(recipient["id"], 0.0), 2)}
            for recipient in finance_view_recipients
        ]

    today_for_chart = date.today()
    last_week_start = today_for_chart - timedelta(days=today_for_chart.weekday() + 7)
    last_week_end = last_week_start + timedelta(days=6)
    month_start = today_for_chart.replace(day=1)
    year_start = today_for_chart.replace(month=1, day=1)

    admin_profit_chart = {
        "last_week": chart_for_period(last_week_start, last_week_end),
        "month": chart_for_period(month_start, today_for_chart),
        "year": chart_for_period(year_start, today_for_chart),
    }

    share_settings = {
        source["id"]: {
            recipient["id"]: next(
                (row["percent"] for row in load_distribution(source["id"]) if row["id"] == recipient["id"]),
                0.0,
            )
            for recipient in recipients
        }
        for source in profit_sources
    }

    return render_template(
        "admin_finance.html",
        title="Финансы",
        branch_rows=[],
        week_rows=[],
        admin_cards=admin_cards,
        total_account=total_account,
        total_hidden_payout=total_hidden_payout,
        total_visible_payout=total_visible_payout,
        total_admin_sum=total_admin_sum,
        date_from=date_from,
        date_to=date_to,
        finance_admins=[{"key": item["id"], "label": item["name"], "user": None} for item in recipients],
        admin_branches=[{"key": item["id"], "label": item["name"]} for item in recipients],
        all_visible_tutors=all_visible_tutors,
        profit_sources=profit_sources,
        profit_recipients=recipients,
        share_settings=share_settings,
        seriy_bonus_items_by_source={},
        admin_profit_by_tutor={row["id"]: row["base_profit"] for row in source_rows},
        seriy_bonus_settings={},
        admin_profit_chart=admin_profit_chart,
    )


def build_payroll_payment_summary(filter_from: Optional[date], filter_to: Optional[date]) -> dict:
    """Отдельная сводка оплат родителей для страницы зарплат.

    Верхние карточки показывают выплаты сотрудникам, а эти четыре карточки
    показывают деньги родителей. Смешивать их нельзя, иначе интерфейс опять
    превращает бухгалтерию в фокус с одинаковыми цифрами.
    """
    summary = {
        "paid_sum": 0.0,
        "pending_sum": 0.0,
        "unpaid_sum": 0.0,
        "records": 0,
    }

    weeks = (
        Week.query
        .join(WeeklyReport, WeeklyReport.week_id == Week.id)
        .filter(WeeklyReport.moderation_status == "approved")
        .all()
    )

    for week in weeks:
        if not week_intersects_period(week, filter_from, filter_to):
            continue

        finance = get_week_finance(week)
        parent_sum = parse_float(finance.get("parent_total"))
        status = (week.payment_status or "unpaid").strip()

        summary["records"] += 1

        if status == "paid" or getattr(week, "receipt_not_required", False):
            summary["paid_sum"] += parent_sum
        elif status == "pending":
            summary["pending_sum"] += parent_sum
        else:
            summary["unpaid_sum"] += parent_sum

    return summary


@app.route("/admin/finance/log")
@login_required
@role_required("admin")
def admin_finance_log():
    """Журнал изменений финансов.

    Показывает, кто и когда менял проценты распределения, ставки,
    цену часа и штрафы. Фильтры: по дате и по подстроке в описании.
    """
    date_from = request.args.get("date_from", "").strip()
    date_to = request.args.get("date_to", "").strip()
    search = request.args.get("search", "").strip()

    query = FinanceChangeLog.query

    filter_from = parse_iso_date(date_from)
    filter_to = parse_iso_date(date_to)

    if filter_from:
        query = query.filter(FinanceChangeLog.changed_at >= datetime.combine(filter_from, dt_time.min))
    if filter_to:
        query = query.filter(FinanceChangeLog.changed_at <= datetime.combine(filter_to, dt_time.max))
    if search:
        query = query.filter(FinanceChangeLog.description.ilike(f"%{search}%"))

    entries = query.order_by(FinanceChangeLog.changed_at.desc(), FinanceChangeLog.id.desc()).limit(500).all()

    return render_template(
        "admin_finance_log.html",
        title="Журнал финансов",
        entries=entries,
        date_from=date_from,
        date_to=date_to,
        search=search,
    )


