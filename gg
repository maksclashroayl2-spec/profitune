@app.route("/admin/backups/<path:filename>/download")
@login_required
@role_required("admin")
def admin_download_backup(filename):
    """Отдаёт файл бэкапа для скачивания.

    Имя файла проверяется строго (только backup_*.db), чтобы через
    этот маршрут нельзя было скачать произвольный файл с сервера.
    """
    safe_name = secure_filename(filename)
    if not re.fullmatch(r"backup_\d{4}-\d{2}-\d{2}_\d{6}\.db", safe_name):
        abort(404)

    full_path = os.path.join(BACKUP_DIR, safe_name)
    if not os.path.isfile(full_path):
        abort(404)

    return send_file(full_path, as_attachment=True, download_name=safe_name)


