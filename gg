    pool = HiddenTutorPool.query.filter_by(
        visible_tutor_id=visible_tutor_id,
        hidden_tutor_id=hidden_tutor_id,
    ).first()

    if week_hours is None:
        return parse_float(pool.hidden_hour_rate if pool else 0)

    return get_hidden_tutor_rate(pool, week_hours)


def parse_iso_date(value: Optional[str]) -> Optional[date]:
    """Строка YYYY-MM-DD -> date, иначе None."""
    if not value:
        return None
    try:
        return datetime.strptime(str(value).strip(), "%Y-%m-%d").date()
    except (TypeError, ValueError):
        return None


def get_fines_for_period(
    filter_from: Optional[date],
    filter_to: Optional[date],
    visible_tutor_id: Optional[int] = None,
    hidden_tutor_id: Optional[int] = None,
) -> list["HiddenTutorFine"]:
    """Штрафы, чей период пересекается с выбранным фильтром.

    Без фильтра возвращаются все штрафы (нескрытого и/или скрытого,
    если они указаны).
    Логика пересечения такая же, как у недель в week_intersects_period.
    """
    query = HiddenTutorFine.query
    if visible_tutor_id:
        query = query.filter_by(visible_tutor_id=visible_tutor_id)
    if hidden_tutor_id:
        query = query.filter_by(hidden_tutor_id=hidden_tutor_id)

    result = []
    for fine in query.all():
        fine_from = parse_iso_date(fine.period_from)
        fine_to = parse_iso_date(fine.period_to)

        if not fine_from and not fine_to:
            continue
        if not fine_from:
            fine_from = fine_to
        if not fine_to:
            fine_to = fine_from

        if filter_from and fine_to < filter_from:
            continue
        if filter_to and fine_from > filter_to:
            continue

        result.append(fine)

    return result


def sum_fines_by_hidden(fines: list["HiddenTutorFine"]) -> dict[int, float]:
    """Суммы штрафов по id скрытого репетитора."""
    totals: dict[int, float] = {}
    for fine in fines:
        totals[fine.hidden_tutor_id] = totals.get(fine.hidden_tutor_id, 0.0) + parse_float(fine.amount)
    return totals


def list_backups() -> list[dict]:
    """Список файлов бэкапа, новые сначала."""
    if not os.path.isdir(BACKUP_DIR):
        return []
    entries = []
    for filename in os.listdir(BACKUP_DIR):
        if not filename.startswith("backup_") or not filename.endswith(".db"):
            continue
        full_path = os.path.join(BACKUP_DIR, filename)
        entries.append({
            "filename": filename,
            "size_bytes": os.path.getsize(full_path),
            "created_at": datetime.fromtimestamp(os.path.getmtime(full_path)),
        })
    entries.sort(key=lambda item: item["created_at"], reverse=True)
    return entries


def cleanup_old_backups(keep: int = BACKUPS_TO_KEEP) -> None:
    """Оставляет только keep самых свежих бэкапов, остальные удаляет."""
    entries = list_backups()
    for entry in entries[keep:]:
        try:
            os.remove(os.path.join(BACKUP_DIR, entry["filename"]))
        except OSError:
            pass


def create_db_backup() -> Optional[str]:
    """Делает консистентный снимок БД через VACUUM INTO и чистит старые.

    Возвращает имя файла или None при ошибке (например, диск занят).
    VACUUM INTO безопасен на работающей базе, в отличие от простого
    копирования файла — не даёт получить повреждённый снимок.
    """
    if not os.path.exists(DB_PATH):
        return None

    filename = f"backup_{datetime.now().strftime('%Y-%m-%d_%H%M%S')}.db"
    target_path = os.path.join(BACKUP_DIR, filename)

    try:
        source = sqlite3.connect(DB_PATH)
        source.execute("VACUUM INTO ?", (target_path,))
        source.close()
    except sqlite3.Error:
        return None

    cleanup_old_backups()
    return filename


def has_backup_today() -> bool:
    today = date.today()
    return any(entry["created_at"].date() == today for entry in list_backups())


_backup_checked_date: Optional[date] = None


def ensure_daily_backup() -> None:
    """Раз в сутки при первом запросе делает автоматический бэкап.

    Проверка на диске (has_backup_today) выполняется не чаще одного
    раза за день на процесс — остальные запросы просто читают дату
    из памяти, не трогая файловую систему.
    """
    global _backup_checked_date
    today = date.today()
    if _backup_checked_date == today:
        return
    try:
        if not has_backup_today():
            create_db_backup()
    except Exception:
        # Бэкап не должен ронять сайт, даже если диск переполнен
        # или права на запись отозваны.
        pass
    finally:
        _backup_checked_date = today


def telegram_is_configured() -> bool:
    return bool(TELEGRAM_BOT_TOKEN)


def send_telegram_message(chat_id: str, text: str) -> tuple[bool, str]:
    """Отправляет сообщение через Bot API. Возвращает (успех, текст ошибки).

    Реализовано на urllib из стандартной библиотеки, чтобы не добавлять
    в проект ещё одну внешнюю зависимость ради одного HTTP-запроса.
    """
    if not telegram_is_configured():
        return False, "Токен бота не настроен (переменная TELEGRAM_BOT_TOKEN)."

    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = json.dumps({"chat_id": chat_id, "text": text}).encode("utf-8")
    request_obj = urllib.request.Request(
        url,
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )

    try:
        with urllib.request.urlopen(request_obj, timeout=10) as response:
            body = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        try:
            body = json.loads(exc.read().decode("utf-8"))
            detail = body.get("description", str(exc))
        except Exception:
            detail = str(exc)
        return False, detail
    except urllib.error.URLError as exc:
        return False, f"Нет соединения с Telegram: {exc}"
    except Exception as exc:
        return False, str(exc)

    if not body.get("ok"):
        return False, body.get("description", "Неизвестная ошибка Telegram API.")

    return True, ""


def generate_telegram_link_code(user: "User") -> str:
