@app.route("/verify-email", methods=["GET", "POST"])
def verify_email():
    """Страница ввода кода подтверждения, отправленного на почту."""
    email = (request.args.get("email") or request.form.get("email") or "").strip().lower()
    user = find_user_by_email(email) if email else None

    if not user:
        flash("Не нашли такой аккаунт. Зарегистрируйтесь заново.", "warning")
        return redirect(url_for("register"))

    if user.email_verified:
        flash("Почта уже подтверждена, можно войти.", "success")
        return redirect(url_for("login"))

    if request.method == "POST":
        if request.form.get("action") == "resend":
            if not can_resend_verification(user):
                flash(
                    f"Код уже отправлен недавно. Подождите {EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS} секунд перед повторной отправкой.",
                    "warning",
                )
                return redirect(url_for("verify_email", email=email))

            success, error_detail = issue_email_verification(user)
            if success:
                flash("Новый код отправлен на почту.", "success")
            else:
                flash(f"Не удалось отправить письмо: {error_detail}", "error")
            return redirect(url_for("verify_email", email=email))

        submitted_code = request.form.get("code", "")
        success, error_detail = check_email_verification_code(user, submitted_code)

        if success:
            flash("Почта подтверждена. Теперь можно войти.", "success")
            return redirect(url_for("login"))

        flash(error_detail, "error")
        return redirect(url_for("verify_email", email=email))

    return render_template(
        "verify_email.html",
        title="Подтверждение почты",
        email=email,
    )


