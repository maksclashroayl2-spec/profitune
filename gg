@app.route("/tutor/calculation")
@login_required
@role_required("tutor")
def tutor_calculation():
    """Финансовая сводка для обычного репетитора."""
    user = current_user()
    date_from = request.args.get("date_from", "").strip()
    date_to = request.args.get("date_to", "").strip()

    if user.is_hidden:
        flash("Раздел подсчёта доступен только основному репетитору.", "warning")
        return redirect(url_for("hidden_reports"))

    def parse_date_filter(value: str) -> Optional[date]:
        if not value:
            return None
        try:
            return datetime.strptime(value, "%Y-%m-%d").date()
        except ValueError:
            return None

    custom_period_selected = bool(date_from or date_to)
    filter_from = parse_date_filter(date_from)
    filter_to = parse_date_filter(date_to)

    if date_from and not filter_from:
        flash("Некорректная дата начала периода.", "warning")
        return redirect(url_for("tutor_calculation"))

    if date_to and not filter_to:
        flash("Некорректная дата окончания периода.", "warning")
        return redirect(url_for("tutor_calculation"))

    if filter_from and filter_to and filter_from > filter_to:
        flash("Дата начала не может быть позже даты окончания.", "warning")
        return redirect(url_for("tutor_calculation"))

    visible_percent = parse_float(user.tutor_profile.profit_percent if user.tutor_profile else 0)

    assignments = TutorAssignment.query.filter_by(tutor_id=user.id).all()
    parent_ids = [assignment.parent_id for assignment in assignments]

    weeks = []
    if parent_ids:
        weeks = (
            Week.query
            .filter(Week.tutor_id == user.id, Week.parent_id.in_(parent_ids))
            .order_by(Week.date_start.desc(), Week.number.desc(), Week.id.desc())
            .all()
        )



    def week_date_range(week: Week) -> tuple[Optional[date], Optional[date]]:
        start = None
        end = None

        if week.date_start:
            try:
                start = datetime.strptime(week.date_start, "%Y-%m-%d").date()
            except ValueError:
                start = None

        if week.date_end:
            try:
                end = datetime.strptime(week.date_end, "%Y-%m-%d").date()
            except ValueError:
                end = None

        return start, end

    def is_completed_week_for_calculation(week: Week) -> bool:
        """Неделя попадает в подсчёт только после окончания.

        Текущие и будущие недели не должны влиять на верхние карточки,
        таблицы и график. Иначе получается не бухгалтерия, а гадание
        по ещё не прошедшим занятиям.
        """
        _, week_end = week_date_range(week)
        return bool(week_end and week_end < date.today())

    # Если пользователь не выбрал период вручную, показываем карточки
    # по последней завершённой неделе. Не за всё время, не по гаданию
    # кофейной гущи, а по последней реально прошедшей неделе.
    if not date_from and not date_to and weeks:
        today = date.today()
        completed_weeks = []

        for week in weeks:
            _, week_end = week_date_range(week)
            if not week_end or week_end >= today:
                continue
            if week.payment_status != "paid":
                continue

            finance = get_week_finance(week)
            hours = parse_float(finance.get("hours"))
            completed_weeks.append((week_end, hours, week))

        # Сначала предпочитаем последнюю завершённую неделю, где есть часы.
        # Если таких нет, берём просто последнюю завершённую неделю.
        completed_with_hours = [item for item in completed_weeks if item[1] > 0]
        source_weeks = completed_with_hours or completed_weeks

        if source_weeks:
            source_weeks.sort(key=lambda item: item[0], reverse=True)
            last_week = source_weeks[0][2]
            date_from = last_week.date_start or ""
            date_to = last_week.date_end or ""
            filter_from = parse_date_filter(date_from)
            filter_to = parse_date_filter(date_to)

    period_caption = (
        "Последняя оплаченная неделя"
        if not custom_period_selected
        else "Выбранный период"
    )

    rows = []
    parent_totals = {}
    tutor_totals = {}

    total_hours = 0.0
    total_parent_sum = 0.0
    total_hidden_sum = 0.0
    total_visible_sum = 0.0
    paid_sum = 0.0
    pending_sum = 0.0
    unpaid_sum = 0.0

    def share_key(source_id: str, recipient_id: str) -> str:
        return f"profit_share_{source_id}_{recipient_id}"

    def get_profit_share_percent(source_id: str, recipient_id: str) -> float:
        return parse_float(get_finance_setting(share_key(str(source_id), str(recipient_id)), 0.0))

    def admin_source_items() -> list[dict]:
        return [
            {"id": "admin_sanya", "name": "Саня"},
            {"id": "admin_seriy", "name": "Серый"},
            {"id": "admin_den", "name": "Дэн"},
        ]

    my_profit_share_details = []

    def week_in_selected_period(week: Week) -> bool:
        """Неделя попадает в фильтр, если пересекается с выбранным периодом."""
        if not filter_from and not filter_to:
            return True

        week_start, week_end = week_date_range(week)

        # Если дат у недели нет, при активном фильтре её лучше не учитывать,
        # иначе финансовая сводка снова начнёт считать что попало. Спасибо, хаос.
        if not week_start and not week_end:
            return False

        if not week_start:
            week_start = week_end

        if not week_end:
            week_end = week_start

        if filter_from and week_end < filter_from:
            return False

        if filter_to and week_start > filter_to:
            return False

        return True

    for week in weeks:
        if not is_completed_week_for_calculation(week):
            continue

        if not week_in_selected_period(week):
            continue

        report = week.report
        if not report:
            continue

        finance = get_week_finance(week)
        hours = parse_float(finance.get("hours"))

        # Пустые недели в подсчёте не показываем, иначе будет кладбище нулей.
        if hours <= 0:
            continue

        parent_sum = parse_float(finance.get("parent_total"))
        hidden_sum = parse_float(finance.get("hidden_total"))
        base_profit = parent_sum - hidden_sum
        my_percent = get_profit_share_percent(user.id, user.id)
        profit = base_profit * my_percent / 100
        status = week.payment_status or "unpaid"

        hidden_tutor = None
        hidden_tutor_id = get_hidden_tutor_id_for_week(week)
        if hidden_tutor_id:
            hidden_tutor = db.session.get(User, hidden_tutor_id)

        row = {
            "week": week,
            "parent": week.parent,
            "hidden_tutor": hidden_tutor,
            "period": format_week_period(week),
            "hours": hours,
            "parent_hour_price": parse_float(finance.get("parent_hour_price")),
            "hidden_hour_rate": parse_float(finance.get("hidden_hour_rate")),
            "parent_sum": parent_sum,
            "hidden_sum": hidden_sum,
            "profit": profit,
            "status": status,
        }
        rows.append(row)

        total_hours += hours
        total_parent_sum += parent_sum
        total_hidden_sum += hidden_sum
        total_visible_sum += profit

        if status == "paid":
            paid_sum += parent_sum
        elif status == "pending":
            pending_sum += parent_sum
        else:
            unpaid_sum += parent_sum

        parent_key = week.parent_id
        if parent_key not in parent_totals:
            assignment = TutorAssignment.query.filter_by(
                parent_id=week.parent_id,
                tutor_id=user.id,
            ).first()
            parent_totals[parent_key] = {
                "parent": week.parent,
                "codename": getattr(getattr(week.parent, "parent_profile", None), "codename", "") or "—",
                "hour_price": parse_float(assignment.parent_hour_price if assignment else 0),
                "hours": 0.0,
                "parent_sum": 0.0,
                "paid_sum": 0.0,
                "pending_sum": 0.0,
                "unpaid_sum": 0.0,
            }

        parent_totals[parent_key]["hours"] += hours
        parent_totals[parent_key]["parent_sum"] += parent_sum
        if status == "paid":
            parent_totals[parent_key]["paid_sum"] += parent_sum
        elif status == "pending":
            parent_totals[parent_key]["pending_sum"] += parent_sum
        else:
            parent_totals[parent_key]["unpaid_sum"] += parent_sum

        if hidden_tutor:
            tutor_key = hidden_tutor.id
            if tutor_key not in tutor_totals:
                tutor_totals[tutor_key] = {
                    "tutor": hidden_tutor,
                    "rate": parse_float(finance.get("hidden_hour_rate")),
                    "hours": 0.0,
                    "hidden_sum": 0.0,
                }

            tutor_totals[tutor_key]["hours"] += hours
            tutor_totals[tutor_key]["hidden_sum"] += hidden_sum

    # Если скрытый репетитор добавлен получателем в распределение прибыли,
    # показываем это рядом с его основной зарплатой за часы.
    # Налог 6.4% со всей суммы, поступившей от родителей, — вычитается
    # первым шагом, до зарплат скрытым и распределения прибыли.
    parent_tax_amount = total_parent_sum * PARENT_REVENUE_TAX_RATE
    parent_sum_after_tax = total_parent_sum - parent_tax_amount

    current_source_base_profit = parent_sum_after_tax - total_hidden_sum

    # Штрафы за выбранный период: уменьшают сумму к выплате скрытому.
    period_fines = get_fines_for_period(filter_from, filter_to, visible_tutor_id=user.id)
    fines_by_hidden = sum_fines_by_hidden(period_fines)
    fines_total = sum(fines_by_hidden.values())

    for tutor_item in tutor_totals.values():
        hidden_user = tutor_item.get("tutor")
        hidden_id = getattr(hidden_user, "id", None)
        share_percent = get_profit_share_percent(user.id, hidden_id) if hidden_id else 0.0
        profit_share_sum = current_source_base_profit * share_percent / 100 if share_percent else 0.0
        fine_sum = parse_float(fines_by_hidden.get(hidden_id, 0.0)) if hidden_id else 0.0
        tutor_item["profit_share_percent"] = share_percent
        tutor_item["profit_share_sum"] = profit_share_sum
        tutor_item["fine_sum"] = fine_sum
        tutor_item["payout_sum"] = parse_float(tutor_item.get("hidden_sum")) - fine_sum
        tutor_item["total_sum"] = parse_float(tutor_item.get("hidden_sum")) + profit_share_sum - fine_sum

    rows.sort(key=lambda item: (item["week"].date_start or "", item["week"].number), reverse=True)

    # Таблица «По родителям» показывает только одну общую последнюю
    # завершённую неделю для всех родителей обычного репетитора.
    # Не последнюю неделю каждого родителя отдельно, иначе в таблице
    # опять появляется винегрет из разных периодов.
    today = date.today()
    parent_week_rows = []

    def report_status_for_week(week: Week) -> str:
        report = week.report
        if not report:
            return "not_written"

        status = report.moderation_status or "draft"
        if status == "pending":
            return "pending"
        if status == "approved":
            return "approved"
        if status == "rejected":
            return "rejected"

        return "not_written"

    completed_week_ranges = []
    for week in weeks:
        week_start, week_end = week_date_range(week)
        if not week_end or week_end >= today:
            continue
        completed_week_ranges.append((week_end, week_start, week))

    completed_week_ranges.sort(key=lambda item: item[0], reverse=True)
    last_completed_week = completed_week_ranges[0][2] if completed_week_ranges else None
    last_week_start, last_week_end = week_date_range(last_completed_week) if last_completed_week else (None, None)

    if last_completed_week and last_week_start and last_week_end:
        for assignment in assignments:
            pair_weeks = (
                Week.query
                .filter_by(parent_id=assignment.parent_id, tutor_id=user.id)
                .order_by(Week.date_end.desc(), Week.number.desc(), Week.id.desc())
                .all()
            )

            week = None
            for candidate in pair_weeks:
                candidate_start, candidate_end = week_date_range(candidate)
                if candidate_start == last_week_start and candidate_end == last_week_end:
                    week = candidate
                    break

            # Если у родителя нет именно этой последней общей недели,
            # не показываем его в таблице контроля.
            if not week:
                continue

            report = week.report
            finance = get_week_finance(week)
            report_status = report_status_for_week(week)

            hidden_assignment = HiddenTutorAssignment.query.filter_by(
                parent_id=assignment.parent_id,
                visible_tutor_id=user.id,
            ).first()

            hidden_tutor = None
            if hidden_assignment:
                hidden_tutor = hidden_assignment.hidden_tutor
            elif report and report.submitted_by_hidden_tutor_id:
                hidden_tutor = db.session.get(User, report.submitted_by_hidden_tutor_id)

            if report_status != "approved":
                payment_status = "waiting_report"
            else:
                payment_status = week.payment_status or "unpaid"

            parent_week_rows.append({
                "parent": assignment.parent,
                "codename": getattr(getattr(assignment.parent, "parent_profile", None), "codename", "") or "—",
                "hidden_tutor_name": hidden_tutor.name if hidden_tutor else "Не назначен",
                "week_label": format_week_period(week),
                "hour_price": parse_float(assignment.parent_hour_price),
                "hours": parse_float(finance.get("hours")),
                "parent_sum": parse_float(finance.get("parent_total")),
                "report_status": report_status,
                "payment_status": payment_status,
            })

    # Данные для графика учебного года: с сентября по август.
    today_for_chart = date.today()
    chart_start_year = today_for_chart.year if today_for_chart.month >= 9 else today_for_chart.year - 1
    chart_start = date(chart_start_year, 9, 1)
    chart_end = date(chart_start_year + 1, 8, 31)

    chart_months = []
    month_names = [
        "Янв", "Фев", "Мар", "Апр", "Май", "Июн",
        "Июл", "Авг", "Сен", "Окт", "Ноя", "Дек",
    ]

    current_month = date(chart_start.year, chart_start.month, 1)
    for _ in range(12):
        chart_months.append({
            "key": current_month.strftime("%Y-%m"),
            "label": f"{month_names[current_month.month - 1]} {current_month.year}",
            "hours": 0.0,
            "parent_sum": 0.0,
            "hidden_sum": 0.0,
            "profit": 0.0,
        })

        if current_month.month == 12:
            current_month = date(current_month.year + 1, 1, 1)
        else:
            current_month = date(current_month.year, current_month.month + 1, 1)

    chart_month_index = {
        item["key"]: item
        for item in chart_months
    }

    chart_weeks = {}

    for week in weeks:
        if not is_completed_week_for_calculation(week):
            continue

        week_start, week_end = week_date_range(week)

        if not week_start and not week_end:
            continue

        if not week_start:
            week_start = week_end

        if not week_end:
            week_end = week_start

        if week_end < chart_start or week_start > chart_end:
            continue

        report = week.report
        if not report:
            continue

        finance = get_week_finance(week)
        hours = parse_float(finance.get("hours"))

        if hours <= 0:
            continue

        parent_sum = parse_float(finance.get("parent_total"))
        hidden_sum = parse_float(finance.get("hidden_total"))
        hidden_fee = hidden_sum * 0.04
        base_profit = parent_sum - hidden_sum - hidden_fee
        my_percent = get_profit_share_percent(user.id, user.id)
        profit = base_profit * my_percent / 100

        week_label = format_week_period(week)
        if week_label not in chart_weeks:
            chart_weeks[week_label] = {
                "sort": week_start,
                "label": week_label,
                "hours": 0.0,
                "parent_sum": 0.0,
                "hidden_sum": 0.0,
                "profit": 0.0,
            }

        chart_weeks[week_label]["hours"] += hours
        chart_weeks[week_label]["parent_sum"] += parent_sum
        chart_weeks[week_label]["hidden_sum"] += hidden_sum
        chart_weeks[week_label]["profit"] += profit

        month_key = week_start.strftime("%Y-%m")
        if month_key in chart_month_index:
            chart_month_index[month_key]["hours"] += hours
            chart_month_index[month_key]["parent_sum"] += parent_sum
            chart_month_index[month_key]["hidden_sum"] += hidden_sum
            chart_month_index[month_key]["profit"] += profit

    chart_week_items = sorted(chart_weeks.values(), key=lambda item: item["sort"])
    chart_month_items = chart_months

    def build_chart_payload(items):
        return {
            "labels": [item["label"] for item in items],
            "hours": [round(item["hours"], 2) for item in items],
            "parent_income": [round(item["parent_sum"], 2) for item in items],
            "hidden_payout": [round(item["hidden_sum"], 2) for item in items],
            "my_share": [round(item["profit"], 2) for item in items],
        }

    chart_data = {
        "weeks": build_chart_payload(chart_week_items),
        "months": build_chart_payload(chart_month_items),
    }

    # Доля текущего репетитора считается по новой схеме распределения прибыли.
    # База: доход родителей - выплаты скрытым - комиссия 4% за эти выплаты.
    # Если текущий репетитор указан получателем у себя, у другого нескрытого или
    # у админа, его доля попадёт сюда. Да, деньги наконец-то нашли адресата.
    current_recipient_id = str(user.id)
    source_direct_to_admin = {item["id"]: 0.0 for item in admin_source_items()}
    my_profit_share_total = 0.0
    my_direct_source_seen = False

    all_visible_sources = User.query.filter_by(role="tutor", is_hidden=False).all()
    for source_user in all_visible_sources:
        source_weeks = Week.query.filter_by(tutor_id=source_user.id).all()
        source_income = 0.0
        source_hidden = 0.0
        source_hours = 0.0
        for week in source_weeks:
            if not is_completed_week_for_calculation(week):
                continue
            if not week_in_selected_period(week):
                continue
            if not week.report:
                continue
            finance = get_week_finance(week)
            hours = parse_float(finance.get("hours"))
            if hours <= 0:
                continue
            source_income += parse_float(finance.get("parent_total"))
            source_hidden += parse_float(finance.get("hidden_total"))
            source_hours += hours

        source_fee = source_hidden * 0.04
        source_base_profit = source_income - source_hidden - source_fee
        if source_base_profit <= 0:
            continue

        my_percent = get_profit_share_percent(source_user.id, current_recipient_id)
        if my_percent > 0:
            amount = source_base_profit * my_percent / 100
            my_profit_share_total += amount
            if source_user.id == user.id:
                my_direct_source_seen = True
            my_profit_share_details.append(f"{source_user.name}: {format_money(amount)} · {format_number(my_percent)}%")

        for admin_source in admin_source_items():
            admin_percent = get_profit_share_percent(source_user.id, admin_source["id"])
            if admin_percent > 0:
                source_direct_to_admin[admin_source["id"]] += source_base_profit * admin_percent / 100

    for admin_source in admin_source_items():
        admin_base = source_direct_to_admin.get(admin_source["id"], 0.0)
        if admin_base <= 0:
            continue
        my_percent = get_profit_share_percent(admin_source["id"], current_recipient_id)
        if my_percent > 0:
            amount = admin_base * my_percent / 100
            my_profit_share_total += amount
            my_profit_share_details.append(f"{admin_source['name']}: {format_money(amount)} · {format_number(my_percent)}%")

    # Защита от ситуации, когда текущий репетитор указан получателем
    # у самого себя в настройках распределения, но общий проход по
    # источникам не попал в его данные из-за фильтров/старой базы.
    # Берём уже посчитанную базу текущей страницы: доход родителей,
    # минус выплаты скрытым, минус комиссия 4% за эти выплаты.
    # Да, деньги должны доходить до того, кого руками добавили в распределение,
    # а не исчезать в цифровом болоте.
    own_base_profit = parent_sum_after_tax - total_hidden_sum
    own_percent = get_profit_share_percent(user.id, current_recipient_id)

    # Жёсткая страховка для «Моя доля». На практике у нас уже были случаи,
    # когда настройка profit_share_<id>_<id> есть, а общий проход по источникам
    # её не показывал из-за старых фильтров/разных версий архива. Если человек
    # явно добавлен получателем собственной прибыли, показываем его долю от
    # текущей базы страницы: доход родителей - выплаты скрытым - комиссия 4%.
    own_detail_exists = any(str(user.name) in str(detail) for detail in my_profit_share_details)
    if own_percent > 0 and own_base_profit != 0 and (not own_detail_exists or my_profit_share_total == 0):
        own_amount = own_base_profit * own_percent / 100
        if not own_detail_exists:
            my_profit_share_total += own_amount
            my_profit_share_details.append(
                f"{user.name}: {format_money(own_amount)} · {format_number(own_percent)}%"
            )
        elif my_profit_share_total == 0:
            my_profit_share_total = own_amount

    total_visible_sum = my_profit_share_total

    # Два новых удержания из итоговой доли: сначала от зарплаты скрытых,
    # затем от того, что осталось, — см. compute_visible_deductions.
    my_deductions = compute_visible_deductions(total_hidden_sum, total_visible_sum)
    total_visible_sum = my_deductions["final_amount"]

    admin_names = ["Саня", "Серый", "Дэн"]
    admin_cards = []
    admin_count = len(admin_names) or 1

    for admin_name in admin_names:
        admin_cards.append({
            "name": admin_name,
            "parent_income": total_parent_sum / admin_count,
            "hidden_payout": total_hidden_sum / admin_count,
            "profit": total_visible_sum / admin_count,
            "hours": total_hours / admin_count,
            "records": int(round(len(rows) / admin_count)) if rows else 0,
        })

    return render_template(
        "tutor_calculation.html",
        title="Подсчёт",
        rows=rows,
        parent_totals=sorted(parent_week_rows, key=lambda item: item["parent"].name),
        tutor_totals=sorted(tutor_totals.values(), key=lambda item: item["tutor"].name),
        total_hours=total_hours,
        total_parent_sum=total_parent_sum,
        total_hidden_sum=total_hidden_sum,
        fines_total=fines_total,
        parent_tax_amount=parent_tax_amount,
        parent_tax_rate=PARENT_REVENUE_TAX_RATE * 100,
        distribution_base_total=(parent_sum_after_tax - total_hidden_sum),
        my_deductions=my_deductions,
        accountant_fee_rate=ACCOUNTANT_FEE_RATE * 100,
        extra_deduction_rate=EXTRA_DEDUCTION_RATE * 100,
        total_profit=total_visible_sum,
        total_visible_sum=total_visible_sum,
        visible_percent=visible_percent,
        paid_sum=paid_sum,
        pending_sum=pending_sum,
        unpaid_sum=unpaid_sum,
        my_profit_share_details=my_profit_share_details,
        date_from=date_from,
        date_to=date_to,
        period_caption=period_caption,
        chart_data=chart_data,
        admin_cards=admin_cards,
        chart_start=chart_start,
        chart_end=chart_end,
    )

@app.route("/tutor/reports")
@login_required
@role_required("tutor")
def visible_tutor_reports():
    """Отчёты для обычного репетитора.

    Страница построена вокруг выбранных репетиторов: сначала показывается
    список репетиторов, а внутри каждого — родители, которым он назначен.
    Для каждого родителя отображаются отчётные недели и прежняя система
    просмотра/модерации отчётов.
    """
    user = current_user()

    if user.is_hidden:
        flash("Для репетитора есть отдельный раздел отчётов.", "warning")
        return redirect(url_for("hidden_reports"))

    my_tutor_links = (
        HiddenTutorPool.query
        .filter_by(visible_tutor_id=user.id)
        .order_by(HiddenTutorPool.id.asc())
        .all()
    )

    unread_by_week = get_unread_week_notification_counts(
        user.id,
        ["visible_receipt_uploaded", "visible_hidden_report_pending", "visible_parent_report_rejected"],
    )

    tutor_groups = []

    for link in my_tutor_links:
        tutor = db.session.get(User, link.hidden_tutor_id)

        if not tutor:
            continue

        assigned_parents = (
            HiddenTutorAssignment.query
            .filter_by(
                visible_tutor_id=user.id,
                hidden_tutor_id=tutor.id,
            )
            .order_by(HiddenTutorAssignment.id.asc())
            .all()
        )

        parent_rows = []
        payment_counter = {
            "paid": 0,
            "pending": 0,
            "unpaid": 0,
        }

        for assignment in assigned_parents:
            weeks = get_weeks_for_pair(assignment.parent_id, user.id)
            published_weeks = [week for week in weeks if report_is_published(week)]

            has_published_reports = bool(published_weeks)

            if not published_weeks:
                parent_payment_state = "hidden"
            elif any(week.payment_status == "pending" for week in published_weeks):
                parent_payment_state = "pending"
            elif any(week.payment_status != "paid" for week in published_weeks):
                parent_payment_state = "unpaid"
            else:
                parent_payment_state = "paid"

            if has_published_reports:
                payment_counter[parent_payment_state] += 1

            parent_unread_count = count_unread_for_weeks(
                [week.id for week in weeks],
                unread_by_week,
            )

            parent_rows.append(
                {
                    "assignment": assignment,
                    "parent": assignment.parent,
                    "weeks": weeks,
                    "payment_state": parent_payment_state,
                    "has_published_reports": has_published_reports,
                    "unread_count": parent_unread_count,
                }
            )

        tutor_groups.append(
            {
                "pool": link,
                "tutor": tutor,
                "parents": parent_rows,
                "payment_counter": payment_counter,
                "unread_count": sum(row["unread_count"] for row in parent_rows),
            }
        )

    return render_template(
        "visible_reports.html",
        title="Отчёты родителей",
        tutor_groups=tutor_groups,
    )




@app.route("/tutor/reports/parent/<int:parent_id>/remove", methods=["POST"])
@login_required
@role_required("tutor")
def visible_tutor_remove_parent(parent_id: int):
    """Убирает родителя из списка отчётов репетитора.

    Пользователь-родитель не удаляется из базы. Удаляется только связь
