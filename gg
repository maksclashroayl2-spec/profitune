@app.route("/register", methods=["GET", "POST"])
def register():
    if request.method == "POST":
        name = request.form.get("name", "").strip()
        email = request.form.get("email", "").strip().lower()
        password = request.form.get("password", "")
        role = request.form.get("role", "parent")

        if not name or not email or not password:
            flash("Пожалуйста, заполните все поля формы.", "warning")
            return redirect(url_for("register"))

        if request.form.get("offer_accepted") != "on":
            flash("Нужно подтвердить, что вы ознакомились с публичной офертой.", "warning")
            return redirect(url_for("register"))

        if request.form.get("pdn_consent") != "on":
            flash(
                "Нужно подтвердить согласие на обработку персональных данных.",
                "warning",
            )
            return redirect(url_for("register"))

        if not EMAIL_RE.match(email):
            flash("Пожалуйста, укажите корректный адрес электронной почты.", "warning")
            return redirect(url_for("register"))

        if not is_allowed_registration_email(email):
            flash(
                "Регистрация возможна только с российских почтовых сервисов: "
                "mail.ru, bk.ru, list.ru, inbox.ru, internet.ru, yandex.ru, ya.ru, rambler.ru.",
                "warning",
            )
            return redirect(url_for("register"))

        if role not in ("parent", "tutor"):
            role = "parent"

        if find_user_by_email(email):
            flash("Пользователь с таким адресом уже зарегистрирован.", "error")
            return redirect(url_for("register"))

        if role == "tutor":
            user = create_user(
                name,
                email,
                password,
                role,
                tutor_status="pending",
                can_edit_profile=False,
                can_receive_bookings=False,
                can_be_visible=False,
            )
            create_tutor_profile(user.id)
            user.offer_accepted_at = datetime.utcnow()
            user.pdn_consent_at = datetime.utcnow()
            db.session.commit()

            if smtp_is_configured():
                user.email_verified = False
                db.session.commit()
                issue_email_verification(user)
                flash(
                    "Мы отправили код подтверждения на вашу почту. Введите его, "
                    "чтобы продолжить — заявка на анкету уйдёт на модерацию после этого.",
                    "success",
                )
                return redirect(url_for("verify_email", email=email))

            flash(
                "Заявка на создание анкеты отправлена на подтверждение модерации.",
                "success",
            )
            return redirect(url_for("login"))

        parent = create_user(name, email, password, role)
        get_or_create_parent_profile(parent)
