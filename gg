@app.route("/tutor/hidden/message/send", methods=["POST"])
@login_required
@role_required("tutor")
def send_parent_message():
    """Отправляет родителю в Telegram одну из готовых фраз.

    Скрытый репетитор выбирает только template_id из списка активных
    шаблонов — свободного текста в форме нет и быть не должно.
    Родитель в сообщении видит имя видимого репетитора, а не скрытого.
    """
    user = current_user()
    if not user.is_hidden:
        flash("Отправка сообщений доступна только репетиторам.", "error")
        return redirect(url_for("hidden_reports"))

    assignment_id = request.form.get("assignment_id", type=int)
    template_id = request.form.get("template_id", type=int)

    assignment = db.session.get(HiddenTutorAssignment, assignment_id) if assignment_id else None
    if not assignment or assignment.hidden_tutor_id != user.id:
        flash("Назначение не найдено.", "warning")
        return redirect(url_for("hidden_reports"))

    template = MessageTemplate.query.filter_by(id=template_id, is_active=True).first()
    if not template:
        flash("Выберите фразу из списка.", "warning")
        return redirect(url_for("hidden_reports", parent_id=assignment.parent_id, tutor_id=assignment.visible_tutor_id))

    parent = assignment.parent
    visible_tutor_name = assignment.visible_tutor.name if assignment.visible_tutor else "Ваш репетитор"
    text_to_send = f"{visible_tutor_name} (ProfiTutors): {template.text}"

    log_entry = HiddenTutorParentMessage(
        assignment_id=assignment.id,
        template_id=template.id,
        text_sent=text_to_send,
    )

    if not parent or not parent.telegram_chat_id:
        log_entry.delivery_status = "no_telegram"
        db.session.add(log_entry)
        db.session.commit()
        flash("Родитель ещё не привязал Telegram-бота — сообщение не отправлено.", "warning")
        return redirect(url_for("hidden_reports", parent_id=assignment.parent_id, tutor_id=assignment.visible_tutor_id))

    success, error_detail = send_telegram_message(parent.telegram_chat_id, text_to_send)
    log_entry.delivery_status = "sent" if success else "failed"
    log_entry.error_detail = error_detail[:255]
    db.session.add(log_entry)
    db.session.commit()

    if success:
        flash("Сообщение отправлено родителю в Telegram.", "success")
    else:
        flash(f"Не удалось отправить сообщение: {error_detail}", "error")

    return redirect(url_for("hidden_reports", parent_id=assignment.parent_id, tutor_id=assignment.visible_tutor_id))


