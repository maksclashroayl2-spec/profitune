# --- Мониторинг ошибок ---------------------------------------------------
# Уровень 1 (всегда работает, без настройки): все ошибки уровня WARNING
# и выше пишутся в instance/logs/app.log с автоматической ротацией —
# файл не растёт бесконечно, хранятся последние 5 файлов по 5 МБ.
_log_handler = RotatingFileHandler(
    os.path.join(LOGS_DIR, "app.log"),
    maxBytes=5 * 1024 * 1024,
    backupCount=5,
    encoding="utf-8",
)
_log_handler.setLevel(logging.WARNING)
_log_handler.setFormatter(
    logging.Formatter("%(asctime)s [%(levelname)s] %(message)s")
)
app.logger.addHandler(_log_handler)
app.logger.setLevel(logging.WARNING)

# Уровень 2 (опционально): если задан SENTRY_DSN — ошибки дополнительно
# улетают в Sentry с полным traceback и контекстом запроса, и оттуда можно
# настроить уведомления на почту/в Slack/Telegram. Без установленного
# пакета sentry-sdk или без DSN сайт продолжает работать как обычно —
# просто без этого уровня.
if SENTRY_DSN:
    try:
        import sentry_sdk
        from sentry_sdk.integrations.flask import FlaskIntegration

        sentry_sdk.init(
            dsn=SENTRY_DSN,
            integrations=[FlaskIntegration()],
            traces_sample_rate=0.0,  # не шлём метрики производительности, только ошибки
            send_default_pii=False,  # не отправлять персональные данные пользователей
        )
        app.logger.info("Sentry подключён.")
    except ImportError:
        app.logger.warning(
            "SENTRY_DSN задан, но пакет sentry-sdk не установлен "
            "(pip install sentry-sdk[flask]) — мониторинг работает только через файл логов."
        )


@app.errorhandler(404)
def handle_not_found(error):
    return render_template("error_page.html", title="Страница не найдена",
                            error_code=404,
                            error_title="Страница не найдена",
                            error_message="Такой страницы не существует или она была перемещена."), 404


@app.errorhandler(500)
def handle_server_error(error):
    # Полный traceback уходит в лог (и в Sentry, если подключён) —
    # пользователь на реальном сайте никогда не должен видеть трейс
    # выполнения, только понятное сообщение.
    app.logger.error("Необработанная ошибка сервера: %s", error, exc_info=True)
    return render_template("error_page.html", title="Ошибка сервера",
                            error_code=500,
                            error_title="Что-то пошло не так",
                            error_message="Мы уже знаем об этой ошибке и разбираемся. "
                                          "Попробуйте обновить страницу через пару минут."), 500


