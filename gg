@app.route("/uploads/reports/<path:filename>")
@login_required
def download_report_attachment(filename):
    """Отдаёт вложение отчёта (в т.ч. чек об оплате) только причастным.

    Причастные: родитель, который загрузил файл; нескрытый репетитор,
    который ведёт эту неделю; скрытый репетитор, написавший отчёт; админ.
    Раньше эти файлы лежали в static/ и были доступны всем по прямой
    ссылке — этот маршрут исправляет именно это.
    """
    safe_name = secure_filename(filename)
    attachment = Attachment.query.filter_by(filename=safe_name).first()

    if not attachment:
        abort(404)

    user = current_user()
    report = attachment.report
    week = db.session.get(Week, report.week_id) if report else None

    is_allowed = (
        user.role == "admin"
        or attachment.parent_id == user.id
        or (week and week.tutor_id == user.id)
        or (report and report.submitted_by_hidden_tutor_id == user.id)
    )

    if not is_allowed:
        abort(403)

    file_path = os.path.join(REPORT_UPLOAD_DIR, safe_name)
    if not os.path.isfile(file_path):
        abort(404)

    return send_file(file_path, as_attachment=False, download_name=attachment.original_filename)


