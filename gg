def get_hidden_tutor_rate(pool: Optional[HiddenTutorPool], week_hours: float = 0) -> float:
    """Возвращает ставку репетитора за конкретную неделю.

    Режим manual: используется ставка, введённая вручную.
    Режим auto: ставка зависит от часов за неделю:
    меньше 16 часов — 400 ₽/ч, 16 часов и больше — 500 ₽/ч.
    """
    if not pool:
        return 0.0

    if (pool.rate_mode or "manual") == "auto":
        return 500.0 if parse_float(week_hours) >= 16 else 400.0

    return parse_float(pool.hidden_hour_rate)


def get_hidden_hour_rate(
