@app.route("/hidden/reports")
@login_required
@role_required("tutor")
def hidden_reports():
    """Вкладка «Отчёты» для репетитора.

    В блоке «Моя зарплата» показываются все родители, по которым
    этот репетитор отправлял отчёты. Период выбирается кнопками:
    последняя оплаченная завершённая неделя, месяц, год или всё время.
    """
    user = current_user()
    period = (
        request.args.get("salary_period")
        or request.args.get("period")
        or "last_week"
    )

    if period not in ("last_week", "month", "year", "all"):
        period = "last_week"

    if not user.is_hidden:
        flash("Раздел отчётов доступен только репетиторам.", "warning")
        return redirect(url_for("index"))

    assignments = HiddenTutorAssignment.query.filter_by(hidden_tutor_id=user.id).all()
    unread_by_week = get_unread_week_notification_counts(
        user.id,
        ["hidden_report_reviewed"],
    )
    today = date.today()

    for assignment in assignments:
        assignment.unread_count = 0
        assignment.last_week = None
        weeks_for_parent = (
            Week.query.filter_by(
                parent_id=assignment.parent_id,
                tutor_id=assignment.visible_tutor_id,
            )
            .order_by(Week.number.desc())
            .all()
        )

        assignment.unread_count = count_unread_for_weeks(
            [week.id for week in weeks_for_parent],
            unread_by_week,
        )

        for week in weeks_for_parent:
            if is_completed_paid_week(week):
                assignment.last_week = week
                break

    salary_candidates = []

    for assignment in assignments:
        pool = HiddenTutorPool.query.filter_by(
            visible_tutor_id=assignment.visible_tutor_id,
            hidden_tutor_id=user.id,
        ).first()

        weeks_for_salary = (
            Week.query.filter_by(
                parent_id=assignment.parent_id,
                tutor_id=assignment.visible_tutor_id,
            )
            .order_by(Week.date_start.desc(), Week.number.desc())
            .all()
        )

        for week in weeks_for_salary:
            if not is_completed_paid_week(week):
                continue

            if not week.report or week.report.submitted_by_hidden_tutor_id != user.id:
                continue

            hours = parse_float(week.report.hours)
            if hours <= 0:
                continue

            week_start, week_end = week_dates_for_filter(week)
            if not week_end:
                continue

            rate = get_hidden_tutor_rate(pool, hours)
            payout = hours * rate

            salary_candidates.append({
                "parent": assignment.parent,
                "visible_tutor": assignment.visible_tutor,
                "period": format_week_period(week),
                "hours": hours,
                "rate": rate,
                "payout": payout,
                "week_start": week_start,
                "week_end": week_end,
            })

    if period == "last_week":
        latest_week_end = max(
            (row["week_end"] for row in salary_candidates if row.get("week_end")),
            default=None,
        )
        salary_rows = [
            row for row in salary_candidates
            if latest_week_end and row.get("week_end") == latest_week_end
        ]
    elif period == "month":
        month_start = today.replace(day=1)
        salary_rows = [
            row for row in salary_candidates
            if row.get("week_end") and row["week_end"] >= month_start and row["week_end"] <= today
        ]
    elif period == "year":
        year_start = today.replace(month=1, day=1)
        salary_rows = [
            row for row in salary_candidates
            if row.get("week_end") and row["week_end"] >= year_start and row["week_end"] <= today
        ]
    else:
        salary_rows = salary_candidates

    salary_rows.sort(key=lambda row: row.get("week_end") or date.min, reverse=True)
    total_salary_hours = sum(row["hours"] for row in salary_rows)
    total_salary_sum = sum(row["payout"] for row in salary_rows)

    # Штрафы за выбранный период. Границы периода зависят от кнопки:
    # для «Последней недели» берём диапазон показанных строк, иначе
    # календарные рамки месяца / года / всего времени.
    if period == "last_week":
        fine_from = min(
            (row["week_start"] for row in salary_rows if row.get("week_start")),
            default=None,
        )
        fine_to = max(
            (row["week_end"] for row in salary_rows if row.get("week_end")),
            default=None,
        )
        my_fines = (
            get_fines_for_period(fine_from, fine_to, hidden_tutor_id=user.id)
            if fine_from or fine_to
            else []
        )
    elif period == "month":
        my_fines = get_fines_for_period(today.replace(day=1), today, hidden_tutor_id=user.id)
    elif period == "year":
        my_fines = get_fines_for_period(today.replace(month=1, day=1), today, hidden_tutor_id=user.id)
    else:
        my_fines = get_fines_for_period(None, None, hidden_tutor_id=user.id)

    fine_rows = []
    for fine in my_fines:
        fine_rows.append({
            "period": f"{fine.period_from} — {fine.period_to}",
            "visible_tutor": fine.visible_tutor,
            "amount": parse_float(fine.amount),
            "comment": fine.comment or "",
        })

    total_fines_sum = sum(row["amount"] for row in fine_rows)
    total_salary_after_fines = total_salary_sum - total_fines_sum

    selected_parent_id = request.args.get("parent_id", type=int)
    selected_tutor_id = request.args.get("tutor_id", type=int)

    selected_assignment = None
    weeks = []

    if selected_parent_id and selected_tutor_id:
        selected_assignment = HiddenTutorAssignment.query.filter_by(
            hidden_tutor_id=user.id,
            parent_id=selected_parent_id,
            visible_tutor_id=selected_tutor_id,
        ).first()
        if selected_assignment:
            weeks = get_weeks_for_pair(selected_parent_id, selected_tutor_id)

    return render_template(
        "hidden_reports.html",
        title="Отчёты",
        assignments=assignments,
        selected_assignment=selected_assignment,
        weeks=weeks,
        salary_rows=salary_rows,
        fine_rows=fine_rows,
        total_fines_sum=total_fines_sum,
        total_salary_after_fines=total_salary_after_fines,
        total_salary_hours=total_salary_hours,
        total_salary_sum=total_salary_sum,
        salary_period=period,
        message_templates=MessageTemplate.query.filter_by(is_active=True)
            .order_by(MessageTemplate.sort_order)
            .all(),
    )



