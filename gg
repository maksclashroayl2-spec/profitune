def smtp_is_configured() -> bool:
    return bool(SMTP_HOST and SMTP_USER and SMTP_PASSWORD)


def send_verification_email(to_email: str, code: str) -> tuple[bool, str]:
    """Отправляет письмо с кодом подтверждения. Возвращает (успех, ошибка)."""
    if not smtp_is_configured():
        return False, "SMTP не настроен."

    subject = "Код подтверждения ProfiTutors"
    body = (
        f"Ваш код подтверждения: {code}\n\n"
        f"Код действителен {EMAIL_VERIFICATION_CODE_TTL_MINUTES} минут.\n"
        "Если вы не регистрировались на ProfiTutors — просто проигнорируйте это письмо."
    )

    message = MIMEText(body, "plain", "utf-8")
    message["Subject"] = subject
    message["From"] = f"{SMTP_FROM_NAME} <{SMTP_FROM_EMAIL}>"
    message["To"] = to_email

    try:
        if SMTP_PORT == 465:
            with smtplib.SMTP_SSL(SMTP_HOST, SMTP_PORT, timeout=15) as server:
                server.login(SMTP_USER, SMTP_PASSWORD)
                server.sendmail(SMTP_FROM_EMAIL, [to_email], message.as_string())
        else:
            with smtplib.SMTP(SMTP_HOST, SMTP_PORT, timeout=15) as server:
                server.starttls()
                server.login(SMTP_USER, SMTP_PASSWORD)
                server.sendmail(SMTP_FROM_EMAIL, [to_email], message.as_string())
    except Exception as exc:
        return False, str(exc)

    return True, ""


def generate_verification_code() -> str:
    return "".join(secrets.choice("0123456789") for _ in range(6))


def issue_email_verification(user: "User") -> tuple[bool, str]:
    """Генерирует новый код, сохраняет его и отправляет письмо.

    Возвращает (успех_отправки, текст_ошибки). Код сохраняется в базе
    в любом случае — даже если письмо не ушло, чтобы не терять состояние.
    """
    code = generate_verification_code()
    user.email_verification_code = code
    user.email_verification_expires = datetime.utcnow() + timedelta(
        minutes=EMAIL_VERIFICATION_CODE_TTL_MINUTES
    )
    user.email_verification_sent_at = datetime.utcnow()
    db.session.commit()

    return send_verification_email(user.email, code)


def can_resend_verification(user: "User") -> bool:
    if not user.email_verification_sent_at:
        return True
    elapsed = (datetime.utcnow() - user.email_verification_sent_at).total_seconds()
    return elapsed >= EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS


def check_email_verification_code(user: "User", submitted_code: str) -> tuple[bool, str]:
    """Проверяет код, введённый пользователем. Возвращает (успех, ошибка)."""
    submitted_code = (submitted_code or "").strip()

    if not user.email_verification_code:
        return False, "Код не был отправлен. Запросите новый."

    if user.email_verification_expires and datetime.utcnow() > user.email_verification_expires:
        return False, "Код истёк. Запросите новый."

    if submitted_code != user.email_verification_code:
        return False, "Неверный код."

    user.email_verified = True
    user.email_verification_code = None
    user.email_verification_expires = None
    db.session.commit()
    return True, ""


_telegram_poll_offset: Optional[int] = None


def _process_telegram_update(update: dict) -> None:
    """Обрабатывает одно входящее сообщение боту: только команда /start <код>."""
    message = update.get("message") or {}
    chat = message.get("chat") or {}
    chat_id = chat.get("id")
    text_in = (message.get("text") or "").strip()

    if not chat_id or not text_in.startswith("/start"):
        return

    parts = text_in.split(maxsplit=1)
    if len(parts) < 2:
        send_telegram_message(
            str(chat_id),
            "Чтобы привязать аккаунт, откройте ссылку из личного кабинета на сайте школы — "
            "она уже содержит нужный код.",
        )
        return

    code = parts[1].strip()
    user = User.query.filter_by(telegram_link_code=code).first()

    if not user:
        send_telegram_message(str(chat_id), "Код недействителен. Получите новую ссылку в личном кабинете.")
        return

    user.telegram_chat_id = str(chat_id)
    user.telegram_link_code = None
    db.session.commit()
    send_telegram_message(
        str(chat_id),
        "Готово! Теперь вы будете получать сюда сообщения от репетитора.",
    )


def _telegram_poll_loop(app_instance) -> None:
    """Фоновый long-polling опрос Telegram — без вебхука и публичного домена.

    Работает даже на локальном компьютере без белого IP и HTTPS,
    единственное требование — исходящий доступ к api.telegram.org.
    Смещение (offset) хранится только в памяти процесса: при перезапуске
    приложения несколько уже обработанных апдейтов могут прийти повторно,
    это не страшно — /start обрабатывается идемпотентно.
    """
    global _telegram_poll_offset

    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/getUpdates"

    while True:
        try:
            params = {"timeout": 25}
            if _telegram_poll_offset is not None:
                params["offset"] = _telegram_poll_offset
            query = urllib.parse.urlencode(params)
            with urllib.request.urlopen(f"{url}?{query}", timeout=30) as response:
                body = json.loads(response.read().decode("utf-8"))

            if body.get("ok"):
                for update in body.get("result", []):
                    _telegram_poll_offset = update["update_id"] + 1
                    with app_instance.app_context():
                        try:
                            _process_telegram_update(update)
                        except Exception:
                            db.session.rollback()
        except Exception:
            # Сеть недоступна или Telegram временно не отвечает — не роняем
            # приложение, просто пробуем ещё раз через паузу.
            time.sleep(5)


def start_telegram_bot_polling(app_instance) -> None:
    """Запускает фоновый поток опроса бота, если токен задан.

    В режиме debug=True Werkzeug перезапускает процесс через reloader,
    и код в блоке main выполняется дважды: сперва в процессе-наблюдателе,
    потом в дочернем «боевом» процессе. WERKZEUG_RUN_MAIN выставлен
    только во втором — поток стартуем только там. В процессе-наблюдателе
    (когда переменной ещё нет) поток не запускаем, иначе бот будет
    опрашиваться из двух потоков одновременно.
    """
    if not telegram_is_configured():
        return
    if os.environ.get("WERKZEUG_RUN_MAIN") is None and _is_reloader_parent_process():
        return
    thread = threading.Thread(target=_telegram_poll_loop, args=(app_instance,), daemon=True)
    thread.start()


def _is_reloader_parent_process() -> bool:
    """True, если приложение запущено с debug=True (значит, будет reloader)."""
