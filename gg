def parse_float(value, default: float = 0.0) -> float:
    """Аккуратно читает дробные числа из формы.

    Поддерживает и точку, и запятую: 1.5 / 1,5.
    Отрицательные значения превращает в 0, чтобы финансы не уходили в
    фантастику, где уроки проводятся минус два часа.
    """
    if value is None:
        return default

    try:
        number = float(str(value).replace(",", ".").strip())
    except (TypeError, ValueError):
        return default

    return max(number, 0.0)


def format_number(value) -> str:
    value = parse_float(value)
    if value.is_integer():
        return str(int(value))
    return (f"{value:.2f}").rstrip("0").rstrip(".")


def format_money(value) -> str:
    value = parse_float(value)
    return f"{value:,.2f}".replace(",", " ").replace(".00", "") + " ₽"


def get_finance_setting(key: str, default: float = 0.0) -> float:
