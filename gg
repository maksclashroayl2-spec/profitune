@app.route("/tutor/fine/set", methods=["POST"])
@login_required
@role_required("tutor")
def set_hidden_tutor_fine():
    """Назначает, обновляет или снимает штраф скрытому за неделю.

    Сумма 0 удаляет штраф. Период приходит из фильтра страницы «Подсчёт».
    """
    user = current_user()
    if user.is_hidden:
        abort(403)

    hidden_tutor_id = request.form.get("hidden_tutor_id", type=int)
    period_from = (request.form.get("period_from") or "").strip()
    period_to = (request.form.get("period_to") or "").strip()
    amount = parse_float(request.form.get("amount"))
    comment = (request.form.get("comment") or "").strip()[:255]

    redirect_url = url_for(
        "tutor_calculation",
        date_from=period_from or None,
        date_to=period_to or None,
    )

    hidden_tutor = db.session.get(User, hidden_tutor_id) if hidden_tutor_id else None
    if not hidden_tutor or hidden_tutor.role != "tutor" or not hidden_tutor.is_hidden:
        flash("Скрытый репетитор не найден.", "warning")
        return redirect(redirect_url)

    # Штрафовать можно только репетитора, который связан с этим нескрытым:
    # через пул или через назначение к его родителям.
    linked = (
        HiddenTutorPool.query.filter_by(
            visible_tutor_id=user.id, hidden_tutor_id=hidden_tutor.id
        ).first()
        or HiddenTutorAssignment.query.filter_by(
            visible_tutor_id=user.id, hidden_tutor_id=hidden_tutor.id
        ).first()
    )
    if not linked:
        flash("Этот репетитор не относится к вашей команде.", "warning")
        return redirect(redirect_url)

    if not parse_iso_date(period_from) or not parse_iso_date(period_to):
        flash("Не удалось определить неделю для штрафа. Выберите период фильтром.", "warning")
        return redirect(url_for("tutor_calculation"))

    fine = HiddenTutorFine.query.filter_by(
        visible_tutor_id=user.id,
        hidden_tutor_id=hidden_tutor.id,
        period_from=period_from,
        period_to=period_to,
    ).first()

    period_label = f"{period_from} — {period_to}"

    if amount <= 0:
        if fine:
            log_finance_change(
                f"Штраф снят: {hidden_tutor.name} ({period_label})",
                format_money(parse_float(fine.amount)),
                "—",
            )
            db.session.delete(fine)
            db.session.commit()
            flash(f"Штраф для {hidden_tutor.name} снят.", "success")
        else:
            flash("Штраф не назначен: сумма 0.", "warning")
        return redirect(redirect_url)

    if fine:
        old_amount = parse_float(fine.amount)
        if round(old_amount, 6) != round(amount, 6):
            log_finance_change(
                f"Штраф изменён: {hidden_tutor.name} ({period_label})",
                format_money(old_amount),
                format_money(amount),
            )
        fine.amount = amount
        fine.comment = comment
    else:
        log_finance_change(
            f"Штраф назначен: {hidden_tutor.name} ({period_label})",
            "—",
            format_money(amount),
        )
        db.session.add(
            HiddenTutorFine(
                visible_tutor_id=user.id,
                hidden_tutor_id=hidden_tutor.id,
                period_from=period_from,
                period_to=period_to,
                amount=amount,
                comment=comment,
            )
        )

    db.session.commit()
    flash(f"Штраф {format_money(amount)} для {hidden_tutor.name} сохранён.", "success")
    return redirect(redirect_url)


