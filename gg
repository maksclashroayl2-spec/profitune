    "admin_den": "Дэн",
}


def finance_party_name(party_id) -> str:
    """Имя участника финансов по его ключу: админ, пользователь или как есть."""
    party_id = str(party_id)
    if party_id in FINANCE_ADMIN_LABELS:
        return FINANCE_ADMIN_LABELS[party_id]
    if party_id.isdigit():
        user = db.session.get(User, int(party_id))
        return user.name if user else f"пользователь id {party_id}"
    return party_id


def log_finance_change(description: str, old_value, new_value) -> None:
    """Пишет строку в журнал финансов. Коммит делает вызывающий код."""
    actor = None
    try:
        actor = current_user()
    except Exception:
        actor = None

    db.session.add(
        FinanceChangeLog(
            description=str(description)[:255],
            old_value=str(old_value)[:80],
            new_value=str(new_value)[:80],
            changed_by_id=actor.id if actor else None,
            changed_by_name=actor.name if actor else "система",
        )
    )


def describe_finance_setting_key(key: str) -> tuple[str, str]:
    """Человекочитаемое описание ключа настройки и тип значения.

    Тип: percent — проценты, flag — вкл/выкл, plain — как есть.
    """
    if key.startswith("profit_share_"):
        rest = key[len("profit_share_"):]
        source = None
        for admin_key in FINANCE_ADMIN_LABELS:
            if rest.startswith(admin_key + "_"):
                source = admin_key
                recipient = rest[len(admin_key) + 1:]
                break
        if source is None:
            source, _, recipient = rest.partition("_")
        return (
            f"Доля прибыли: {finance_party_name(source)} → {finance_party_name(recipient)}",
            "percent",
        )

    return (f"Настройка: {key}", "plain")


def format_setting_value(value: float, value_type: str) -> str:
    if value_type == "flag":
        return "вкл" if parse_float(value) else "выкл"
    if value_type == "percent":
        return f"{format_number(value)}%"
    return format_number(value)


def set_finance_setting(key: str, value) -> None:
    new_value = parse_float(value)
    setting = AdminFinanceSetting.query.filter_by(key=key).first()

    if not setting:
        # Первичное создание нулевой настройки в журнал не пишем,
        # иначе каждое сохранение формы засоряет журнал пустыми строками.
        if new_value != 0:
            description, value_type = describe_finance_setting_key(key)
            log_finance_change(
                description,
                format_setting_value(0.0, value_type),
                format_setting_value(new_value, value_type),
            )
        setting = AdminFinanceSetting(key=key, value=new_value)
        db.session.add(setting)
        return

    old_value = parse_float(setting.value)
    if round(old_value, 6) != round(new_value, 6):
        description, value_type = describe_finance_setting_key(key)
        log_finance_change(
            description,
            format_setting_value(old_value, value_type),
            format_setting_value(new_value, value_type),
        )
    setting.value = new_value



def compute_visible_deductions(hidden_salary_sum: float, own_share_before: float) -> dict:
    """Считает оба новых удержания из доли одного нескрытого репетитора.

    Первое — 1% и 0,5% от суммы зарплаты репетиторам (скрытым), не
    зависит от процента самого нескрытого. Второе — 1% и 0,5% от того,
    что у нескрытого осталось ПОСЛЕ первого удержания (то есть после
    всех предыдущих процентов: налог, зарплата скрытым, доля прибыли,
    и теперь ещё первое удержание). 1% в обоих случаях — зарплата
    бухгалтера, 0,5% — отдельное удержание без привязки к получателю.
    """
    hidden_salary_sum = parse_float(hidden_salary_sum)
    own_share_before = parse_float(own_share_before)

    accountant_part_1 = hidden_salary_sum * ACCOUNTANT_FEE_RATE
    extra_part_1 = hidden_salary_sum * EXTRA_DEDUCTION_RATE
    amount_after_first = own_share_before - accountant_part_1 - extra_part_1

    accountant_part_2 = amount_after_first * ACCOUNTANT_FEE_RATE
    extra_part_2 = amount_after_first * EXTRA_DEDUCTION_RATE
    final_amount = amount_after_first - accountant_part_2 - extra_part_2

    return {
        "accountant_part_1": accountant_part_1,
        "extra_part_1": extra_part_1,
        "amount_after_first": amount_after_first,
        "accountant_part_2": accountant_part_2,
        "extra_part_2": extra_part_2,
        "final_amount": final_amount,
        "accountant_total": accountant_part_1 + accountant_part_2,
        "extra_total": extra_part_1 + extra_part_2,
        "deduction_total": accountant_part_1 + extra_part_1 + accountant_part_2 + extra_part_2,
    }


