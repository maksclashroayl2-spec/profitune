def get_default_week_dates(number: int) -> tuple[str, str]:
    """Возвращает даты недели: текущий понедельник + номер недели."""
    today = date.today()

    monday = today - timedelta(days=today.weekday())
    start = monday + timedelta(days=(number - 1) * 7)
    end = start + timedelta(days=6)
    return start.isoformat(), end.isoformat()


def format_week_period(week: Week) -> str:
    """Красивый период для карточек отчёта."""
    try:
        if week.date_start and week.date_end:
            start = datetime.strptime(week.date_start, "%Y-%m-%d").strftime("%d.%m")
            end = datetime.strptime(week.date_end, "%Y-%m-%d").strftime("%d.%m")
            return f"{start} - {end}"
    except ValueError:
        pass
    return f"{week.number}-я неделя"




