def build_payroll_workbook(
    admin_rows: list,
    visible_rows: list,
    hidden_rows: list,
    hidden_groups: list,
    totals: dict,
    period_caption: str,
) -> BytesIO:
    """Собирает ведомость выплат в Excel: три листа + итоги.

    Лист «Скрытые» группируется по нескрытым репетиторам — так же,
    как на странице «Зарплаты», а не одним плоским списком.
    """
    wb = Workbook()
    header_fill = PatternFill("solid", fgColor="EDE9FE")
    header_font = Font(bold=True, color="4C1D95")
    bold = Font(bold=True)
    money_format = "#,##0.00 ₽"

    def autosize(ws, widths: list[int]) -> None:
        for col_idx, width in enumerate(widths, start=1):
            ws.column_dimensions[get_column_letter(col_idx)].width = width

    # --- Лист 1: Админы ---
    ws_admins = wb.active
    ws_admins.title = "Админы"
    ws_admins.cell(row=1, column=1, value=f"Период: {period_caption}").font = bold
    for col_idx, title in enumerate(["Имя", "Роль", "Основание", "К выплате, ₽"], start=1):
        cell = ws_admins.cell(row=2, column=col_idx, value=title)
        cell.font = header_font
        cell.fill = header_fill
    ws_admins.freeze_panes = "A3"
    row_idx = 3
    for row in admin_rows:
        ws_admins.cell(row=row_idx, column=1, value=row.get("name", ""))
        ws_admins.cell(row=row_idx, column=2, value=row.get("role", ""))
        ws_admins.cell(row=row_idx, column=3, value=row.get("basis", ""))
        amount_cell = ws_admins.cell(row=row_idx, column=4, value=parse_float(row.get("amount", 0.0)))
        amount_cell.number_format = money_format
        row_idx += 1
    total_cell = ws_admins.cell(row=row_idx + 1, column=1, value="Итого")
    total_cell.font = bold
    total_amount = ws_admins.cell(row=row_idx + 1, column=4, value=parse_float(totals.get("admins", 0.0)))
    total_amount.font = bold
    total_amount.number_format = money_format
    autosize(ws_admins, [24, 20, 46, 16])

    # --- Лист 2: Нескрытые ---
    ws_visible = wb.create_sheet("Нескрытые")
    ws_visible.cell(row=1, column=1, value=f"Период: {period_caption}").font = bold
    columns_visible = ["Имя", "Часы", "Родителей", "Основание", "К выплате, ₽"]
    for col_idx, title in enumerate(columns_visible, start=1):
        cell = ws_visible.cell(row=2, column=col_idx, value=title)
        cell.font = header_font
        cell.fill = header_fill
    ws_visible.freeze_panes = "A3"
    row_idx = 3
    for row in visible_rows:
        ws_visible.cell(row=row_idx, column=1, value=row.get("name", ""))
        hours = row.get("hours")
        ws_visible.cell(row=row_idx, column=2, value=parse_float(hours) if hours is not None else None)
        ws_visible.cell(row=row_idx, column=3, value=row.get("parents_count", 0))
        ws_visible.cell(row=row_idx, column=4, value=row.get("basis", ""))
        amount_cell = ws_visible.cell(row=row_idx, column=5, value=parse_float(row.get("amount", 0.0)))
        amount_cell.number_format = money_format
        row_idx += 1
    total_cell = ws_visible.cell(row=row_idx + 1, column=1, value="Итого")
    total_cell.font = bold
    total_amount = ws_visible.cell(row=row_idx + 1, column=5, value=parse_float(totals.get("visible", 0.0)))
    total_amount.font = bold
    total_amount.number_format = money_format
    autosize(ws_visible, [24, 10, 12, 50, 16])

    # --- Лист 3: Скрытые, сгруппированные по нескрытым ---
    ws_hidden = wb.create_sheet("Скрытые")
    ws_hidden.cell(row=1, column=1, value=f"Период: {period_caption}").font = bold
    columns_hidden = ["Скрытый репетитор", "Часы", "Родителей", "Основание", "К выплате, ₽"]
    for col_idx, title in enumerate(columns_hidden, start=1):
        cell = ws_hidden.cell(row=2, column=col_idx, value=title)
        cell.font = header_font
        cell.fill = header_fill
    ws_hidden.freeze_panes = "A3"
    row_idx = 3

    if hidden_groups:
        for group in hidden_groups:
            group_cell = ws_hidden.cell(row=row_idx, column=1, value=f"Команда: {group.get('visible_name', '')}")
            group_cell.font = bold
            for col in range(2, 6):
                ws_hidden.cell(row=row_idx, column=col).fill = PatternFill("solid", fgColor="F5F3FF")
            row_idx += 1
            for row in group.get("rows", []):
                ws_hidden.cell(row=row_idx, column=1, value="    " + row.get("name", ""))
                ws_hidden.cell(row=row_idx, column=2, value=parse_float(row.get("hours", 0.0)))
                ws_hidden.cell(row=row_idx, column=3, value=row.get("parents_count", 0))
                ws_hidden.cell(row=row_idx, column=4, value=row.get("basis", ""))
                amount_cell = ws_hidden.cell(row=row_idx, column=5, value=parse_float(row.get("amount", 0.0)))
                amount_cell.number_format = money_format
                row_idx += 1
    else:
        for row in hidden_rows:
            ws_hidden.cell(row=row_idx, column=1, value=row.get("name", ""))
            ws_hidden.cell(row=row_idx, column=2, value=parse_float(row.get("hours", 0.0)))
            ws_hidden.cell(row=row_idx, column=3, value=row.get("parents_count", 0))
            ws_hidden.cell(row=row_idx, column=4, value=row.get("basis", ""))
            amount_cell = ws_hidden.cell(row=row_idx, column=5, value=parse_float(row.get("amount", 0.0)))
            amount_cell.number_format = money_format
            row_idx += 1

    total_cell = ws_hidden.cell(row=row_idx + 1, column=1, value="Итого")
    total_cell.font = bold
    total_amount = ws_hidden.cell(row=row_idx + 1, column=5, value=parse_float(totals.get("hidden", 0.0)))
    total_amount.font = bold
    total_amount.number_format = money_format
    autosize(ws_hidden, [30, 10, 12, 50, 16])

    buffer = BytesIO()
    wb.save(buffer)
    buffer.seek(0)
    return buffer


@app.route("/admin/payroll")
@login_required
@role_required("admin")
def admin_payroll():
    """Ведомость выплат: админы, нескрытые и скрытые репетиторы.

    Админы и нескрытые получают суммы из новой схемы распределения прибыли.
    Скрытые получают фиксированную оплату по часам. Наконец-то все три карточки
    считают одну и ту же реальность, а не три параллельные вселенные.
    """
    payout_type = request.args.get("type", "admins").strip()
    date_from = request.args.get("date_from", "").strip()
    date_to = request.args.get("date_to", "").strip()

    if payout_type not in ("admins", "visible", "hidden"):
        payout_type = "admins"

    def parse_date_filter(value: str) -> Optional[date]:
        if not value:
            return None
        try:
            return datetime.strptime(value, "%Y-%m-%d").date()
        except ValueError:
            return None

    custom_period_selected = bool(date_from or date_to)
    filter_from = parse_date_filter(date_from)
    filter_to = parse_date_filter(date_to)

    if date_from and not filter_from:
        flash("Некорректная дата начала периода.", "warning")
        return redirect(url_for("admin_payroll", type=payout_type))

    if date_to and not filter_to:
        flash("Некорректная дата окончания периода.", "warning")
        return redirect(url_for("admin_payroll", type=payout_type))

    if filter_from and filter_to and filter_from > filter_to:
        flash("Дата начала не может быть позже даты окончания периода.", "warning")
        return redirect(url_for("admin_payroll", type=payout_type))

    if not custom_period_selected:
        filter_from, filter_to = latest_completed_paid_week_period()
        date_from = filter_from.isoformat() if filter_from else ""
        date_to = filter_to.isoformat() if filter_to else ""

    period_caption = "Последняя оплаченная неделя" if not custom_period_selected else "Выбранный период"

    all_visible_tutors = (
        User.query
        .filter_by(role="tutor", is_hidden=False)
        .order_by(User.name.asc())
        .all()
    )
    all_hidden_tutors = (
        User.query
        .filter_by(role="tutor", is_hidden=True)
        .order_by(User.name.asc())
        .all()
    )

    admin_recipients = [
        {"id": "admin_sanya", "name": "Саня", "role": "Администратор", "is_admin": True},
        {"id": "admin_seriy", "name": "Серый", "role": "Администратор", "is_admin": True},
        {"id": "admin_den", "name": "Дэн", "role": "Администратор", "is_admin": True},
    ]

    recipients = list(admin_recipients)
    used_recipient_ids = {item["id"] for item in recipients}
    for user in all_visible_tutors:
        recipient_id = str(user.id)
        if recipient_id in used_recipient_ids:
            continue
        used_recipient_ids.add(recipient_id)
        recipients.append({
            "id": recipient_id,
            "name": user.name,
            "role": "Нескрытый репетитор",
            "is_admin": False,
            "is_hidden_recipient": False,
            "user_id": user.id,
        })

    for user in all_hidden_tutors:
        recipient_id = str(user.id)
        if recipient_id in used_recipient_ids:
            continue
        used_recipient_ids.add(recipient_id)
        recipients.append({
            "id": recipient_id,
            "name": user.name,
            "role": "Скрытый репетитор",
            "is_admin": False,
            "is_hidden_recipient": True,
            "user_id": user.id,
        })

    def share_key(source_id: str, recipient_id: str) -> str:
        return f"profit_share_{source_id}_{recipient_id}"

    def load_distribution(source_id: str) -> list[dict]:
        rows = []
        for recipient in recipients:
            percent = parse_float(get_finance_setting(share_key(str(source_id), recipient["id"]), 0.0))
            if percent > 0:
                rows.append({**recipient, "percent": percent})
        return rows

    recipient_totals = {recipient["id"]: 0.0 for recipient in recipients}
    recipient_hours = {recipient["id"]: 0.0 for recipient in recipients}
    recipient_parent_ids = {recipient["id"]: set() for recipient in recipients}
    recipient_details = {recipient["id"]: [] for recipient in recipients}
    visible_source_stats = {
        tutor.id: {
            "parents_count": 0,
            "parent_ids": set(),
            "hours": 0.0,
            "income": 0.0,
            "hidden_payout": 0.0,
            "net_profit": 0.0,
            "paid_count": 0,
            "pending_count": 0,
            "unpaid_count": 0,
            "payment_records": 0,
        }
        for tutor in all_visible_tutors
    }
    hidden_rows_map = {}
    hidden_group_rows_map = {}
    payment_summary = {
        "paid_sum": 0.0,
        "pending_sum": 0.0,
        "unpaid_sum": 0.0,
        "records": 0,
    }

    for visible_tutor in all_visible_tutors:
        hidden_group = hidden_group_rows_map.setdefault(visible_tutor.id, {
            "visible_id": visible_tutor.id,
            "visible_name": visible_tutor.name,
            "rows": {},
        })
        tutor_income = 0.0
        tutor_hidden_payout = 0.0
        tutor_hours = 0.0
        tutor_parent_ids = set()
        source_paid_count = 0
        source_pending_count = 0
        source_unpaid_count = 0
        source_payment_records = 0

        weeks = (
            Week.query
            .filter_by(tutor_id=visible_tutor.id)
            .order_by(Week.date_start.asc(), Week.number.asc(), Week.id.asc())
            .all()
        )

        for week in weeks:
            if not week_intersects_period(week, filter_from, filter_to):
                continue
            if not week.report:
                continue

            finance = get_week_finance(week)
            hours = parse_float(finance.get("hours"))
            if hours <= 0:
                continue

            parent_sum = parse_float(finance.get("parent_total"))
            hidden_sum = parse_float(finance.get("hidden_total"))

            # Платёжные карточки и подсветка нескрытых смотрят на все отчётные
            # недели выбранного периода, а не только на paid. Иначе красные
            # карточки опять играют в прятки, потому что, видите ли, денег нет.
            report_status = getattr(week.report, "moderation_status", None)
            if report_status == "approved":
                payment_summary["records"] += 1
                source_payment_records += 1
                status = week.payment_status or "unpaid"
                if status == "paid":
                    payment_summary["paid_sum"] += parent_sum
                    source_paid_count += 1
                elif status == "pending":
                    payment_summary["pending_sum"] += parent_sum
                    source_pending_count += 1
                else:
                    payment_summary["unpaid_sum"] += parent_sum
                    source_unpaid_count += 1

            if not is_completed_paid_week(week):
                continue

            tutor_income += parent_sum
            tutor_hidden_payout += hidden_sum
            tutor_hours += hours
            tutor_parent_ids.add(week.parent_id)

            hidden_tutor_id = finance.get("hidden_tutor_id")
            if hidden_tutor_id and hidden_sum > 0:
                hidden_user = db.session.get(User, hidden_tutor_id)
                if hidden_user:
                    hidden_row = hidden_rows_map.setdefault(hidden_tutor_id, {
                        "name": hidden_user.name,
                        "role": "Скрытый репетитор",
                        "basis": "Часы × ставка",
                        "hours": 0.0,
                        "amount": 0.0,
                        "parents_count": 0,
                        "parent_ids": set(),
                    })
                    hidden_row["hours"] += hours
                    hidden_row["amount"] += hidden_sum
                    hidden_row["parent_ids"].add(week.parent_id)

                    group_row = hidden_group["rows"].setdefault(hidden_tutor_id, {
                        "name": hidden_user.name,
                        "role": "Скрытый репетитор",
                        "basis": "Часы × ставка",
                        "hours": 0.0,
                        "amount": 0.0,
                        "parents_count": 0,
                        "parent_ids": set(),
                    })
                    group_row["hours"] += hours
                    group_row["amount"] += hidden_sum
                    group_row["parent_ids"].add(week.parent_id)

        tutor_tax_amount = tutor_income * PARENT_REVENUE_TAX_RATE
        # Прибыль распределяем после налога и выплаты скрытым.
        # Налог 6.4% со всей суммы от родителей вычитается первым шагом.
        base_profit = (tutor_income - tutor_tax_amount) - tutor_hidden_payout
        visible_source_stats[visible_tutor.id] = {
            "parents_count": len(tutor_parent_ids),
            "parent_ids": tutor_parent_ids,
            "hours": tutor_hours,
            "income": tutor_income,
            "tax_amount": tutor_tax_amount,
            "hidden_payout": tutor_hidden_payout,
            "net_profit": base_profit,
            "paid_count": source_paid_count,
            "pending_count": source_pending_count,
            "unpaid_count": source_unpaid_count,
            "payment_records": source_payment_records,
        }

        if base_profit == 0 and tutor_hours == 0:
            continue

        distribution = load_distribution(str(visible_tutor.id))
        for row in distribution:
            amount = base_profit * parse_float(row.get("percent")) / 100
            recipient_totals[row["id"]] = recipient_totals.get(row["id"], 0.0) + amount
            recipient_hours[row["id"]] = recipient_hours.get(row["id"], 0.0) + tutor_hours
            recipient_parent_ids[row["id"]].update(tutor_parent_ids)
            recipient_details[row["id"]].append(
                f"{visible_tutor.name}: {format_money(amount)} · {format_number(row['percent'])}%"
            )

            if row.get("is_hidden_recipient"):
                hidden_user_id = row.get("user_id")
                if hidden_user_id:
                    hidden_row = hidden_rows_map.setdefault(hidden_user_id, {
                        "name": row["name"],
                        "role": "Скрытый репетитор",
                        "basis": "Часы × ставка",
                        "hours": 0.0,
                        "amount": 0.0,
                        "profit_share": 0.0,
                        "parents_count": 0,
                        "parent_ids": set(),
                    })
                    hidden_row["profit_share"] = parse_float(hidden_row.get("profit_share")) + amount

                    group_row = hidden_group["rows"].setdefault(hidden_user_id, {
                        "name": row["name"],
                        "role": "Скрытый репетитор",
                        "basis": "Часы × ставка",
                        "hours": 0.0,
                        "amount": 0.0,
                        "profit_share": 0.0,
                        "parents_count": 0,
                        "parent_ids": set(),
                    })
                    group_row["profit_share"] = parse_float(group_row.get("profit_share")) + amount

    # Второй уровень: если прибыль пришла Сане/Серому/Дэну, её тоже можно
    # распределить дальше по настройкам этих трёх источников. Берём один уровень,
    # чтобы не устроить вечный денежный пинг-понг между админами.
    admin_direct_totals = {admin["id"]: recipient_totals.get(admin["id"], 0.0) for admin in admin_recipients}
    for admin in admin_recipients:
        source_id = admin["id"]
        base_profit = admin_direct_totals.get(source_id, 0.0)
        distribution = load_distribution(source_id)
        if not distribution or base_profit == 0:
            continue

        recipient_totals[source_id] = recipient_totals.get(source_id, 0.0) - base_profit
        for row in distribution:
            amount = base_profit * parse_float(row.get("percent")) / 100
            recipient_totals[row["id"]] = recipient_totals.get(row["id"], 0.0) + amount
            recipient_details[row["id"]].append(
                f"{admin['name']}: {format_money(amount)} · {format_number(row['percent'])}%"
            )

    # Обе старые комиссии (4% за выплаты скрытым и 4% за выплату самому
    # нескрытому) отменены — словари ниже оставлены пустыми (все нули),
    # чтобы не переписывать шаблон, который всё ещё ссылается на эти поля.
    visible_recipient_ids = [str(user.id) for user in all_visible_tutors]
    gross_recipient_totals = {key: parse_float(value) for key, value in recipient_totals.items()}
    hidden_fee_by_visible = {visible_id: 0.0 for visible_id in visible_recipient_ids}
    visible_transfer_fee_by_visible = {visible_id: 0.0 for visible_id in visible_recipient_ids}
    own_transfer_fee_by_visible = {visible_id: 0.0 for visible_id in visible_recipient_ids}

    # Новые удержания 1%+0,5%: сначала от зарплаты скрытых этого нескрытого,
    # затем от того, что у него осталось после этого — см.
    # compute_visible_deductions. 1% в обеих ступенях — зарплата бухгалтера,
    # сумма по всем нескрытым показывается в ведомости отдельной строкой.
    accountant_fee_by_visible = {visible_id: 0.0 for visible_id in visible_recipient_ids}
    extra_fee_by_visible = {visible_id: 0.0 for visible_id in visible_recipient_ids}

    for tutor in all_visible_tutors:
        visible_id = str(tutor.id)
        hidden_salary_for_tutor = parse_float(
            visible_source_stats.get(tutor.id, {}).get("hidden_payout", 0.0)
        )
        own_share_before = parse_float(recipient_totals.get(visible_id, 0.0))
        deductions = compute_visible_deductions(hidden_salary_for_tutor, own_share_before)
        accountant_fee_by_visible[visible_id] = deductions["accountant_total"]
        extra_fee_by_visible[visible_id] = deductions["extra_total"]
        recipient_totals[visible_id] = deductions["final_amount"]

    accountant_fee_grand_total = sum(accountant_fee_by_visible.values())

    admin_rows = []
    visible_rows = []

    for recipient in recipients:
        amount = parse_float(recipient_totals.get(recipient["id"], 0.0))

        # Админов показываем только если им реально есть что выплачивать.
        # А вот нескрытых репетиторов выводим всех, даже с нулём, чтобы в
        # ведомости был полный список команды, а не клуб тех, кому повезло
        # попасть в расчёт. Финансы и так любят прятаться по углам.
        if recipient.get("is_admin") and amount <= 0:
            continue

        basis_items = recipient_details.get(recipient["id"], [])
        if basis_items:
            basis = "; ".join(basis_items[:3])
        elif recipient.get("is_admin"):
            basis = "Распределение прибыли"
        else:
            basis = "Нет начислений за выбранный период"

        if len(basis_items) > 3:
            basis += f"; ещё {len(basis_items) - 3}"

        source_stats = None
        if not recipient.get("is_admin"):
            source_stats = visible_source_stats.get(recipient.get("user_id"), {})

        row = {
            "name": recipient["name"],
            "role": "Администратор" if recipient.get("is_admin") else "Нескрытый репетитор",
            "basis": basis,
            "hours": None if recipient.get("is_admin") else recipient_hours.get(recipient["id"], 0.0),
            "amount": amount,
            "gross_amount": parse_float(gross_recipient_totals.get(recipient["id"], amount)),
            "accountant_fee_share": parse_float(accountant_fee_by_visible.get(recipient["id"], 0.0)),
            "extra_fee_share": parse_float(extra_fee_by_visible.get(recipient["id"], 0.0)),
            "hidden_fee_share": parse_float(hidden_fee_by_visible.get(recipient["id"], 0.0)),
            "visible_transfer_fee_share": parse_float(visible_transfer_fee_by_visible.get(recipient["id"], 0.0)),
            "own_transfer_fee": parse_float(own_transfer_fee_by_visible.get(recipient["id"], 0.0)),
            "parents_count": len(recipient_parent_ids.get(recipient["id"], set())),
            "source_parents_count": parse_float(source_stats.get("parents_count", 0)) if source_stats is not None else None,
            "source_hours": parse_float(source_stats.get("hours", 0.0)) if source_stats is not None else None,
            "source_income": parse_float(source_stats.get("income", 0.0)) if source_stats is not None else None,
            "source_hidden_payout": parse_float(source_stats.get("hidden_payout", 0.0)) if source_stats is not None else None,
            "source_net_profit": parse_float(source_stats.get("net_profit", 0.0)) if source_stats is not None else None,
            "payment_records": int(source_stats.get("payment_records", 0)) if source_stats is not None else 0,
            "paid_count": int(source_stats.get("paid_count", 0)) if source_stats is not None else 0,
            "pending_count": int(source_stats.get("pending_count", 0)) if source_stats is not None else 0,
            "unpaid_count": int(source_stats.get("unpaid_count", 0)) if source_stats is not None else 0,
        }

        if not recipient.get("is_admin"):
            if row["payment_records"] <= 0:
                row["payment_class"] = "neutral"
                row["payment_label"] = "Нет отчётов"
            elif row["pending_count"] > 0:
                row["payment_class"] = "warning"
                row["payment_label"] = "Есть чеки на проверке"
            elif row["unpaid_count"] > 0:
                row["payment_class"] = "danger"
                row["payment_label"] = "Оплачено не всё"
            else:
                row["payment_class"] = "success"
                row["payment_label"] = "Все оплачено"

        if recipient.get("is_admin"):
            admin_rows.append(row)
        elif recipient.get("is_hidden_recipient"):
            # Скрытые как получатели прибыли показываются в разделе «Скрытым»
            # вместе с основной оплатой за часы, а не в блоке нескрытых.
            pass
        else:
            visible_rows.append(row)

    # Штрафы за период: по скрытому в общем списке и по паре
    # (нескрытый, скрытый) в группировке по командам.
    payroll_fines = get_fines_for_period(filter_from, filter_to)
    payroll_fines_by_hidden = sum_fines_by_hidden(payroll_fines)
    payroll_fines_by_pair: dict[tuple[int, int], float] = {}
    for fine_item in payroll_fines:
        pair_key = (fine_item.visible_tutor_id, fine_item.hidden_tutor_id)
        payroll_fines_by_pair[pair_key] = (
            payroll_fines_by_pair.get(pair_key, 0.0) + parse_float(fine_item.amount)
        )

    hidden_rows = []
    for hidden_user in all_hidden_tutors:
        row = hidden_rows_map.setdefault(hidden_user.id, {
            "name": hidden_user.name,
            "role": "Скрытый репетитор",
            "basis": "Часы × ставка",
            "hours": 0.0,
            "amount": 0.0,
            "parents_count": 0,
            "parent_ids": set(),
        })
        base_salary = parse_float(row.get("amount", 0.0))
        profit_share = parse_float(recipient_totals.get(str(hidden_user.id), 0.0))
        fine_sum = parse_float(payroll_fines_by_hidden.get(hidden_user.id, 0.0))
        row["base_salary"] = base_salary
        row["profit_share"] = profit_share
        row["fine_sum"] = fine_sum
        row["amount"] = base_salary + profit_share - fine_sum
        basis_parts = []
        if profit_share > 0 or fine_sum > 0:
            basis_parts.append(f"Часы × ставка: {format_money(base_salary)}")
        if profit_share > 0:
            basis_parts.append(f"доля прибыли: {format_money(profit_share)}")
        if fine_sum > 0:
            basis_parts.append(f"штраф: −{format_money(fine_sum)}")
        if basis_parts:
            row["basis"] = "; ".join(basis_parts)
        row["parents_count"] = len(row.pop("parent_ids", set())) if "parent_ids" in row else row.get("parents_count", 0)
        if parse_float(row.get("amount")) != 0 or parse_float(row.get("hours")) > 0 or fine_sum > 0:
            hidden_rows.append(row)

    hidden_groups = []
    for group in hidden_group_rows_map.values():
        group_rows = []
        for hidden_id, row in group["rows"].items():
            row["parents_count"] = len(row.pop("parent_ids", set()))
            base_salary = parse_float(row.get("amount", 0.0))
            profit_share = parse_float(row.get("profit_share", 0.0))
            fine_sum = parse_float(
                payroll_fines_by_pair.get((group["visible_id"], hidden_id), 0.0)
            )
            row["base_salary"] = base_salary
            row["profit_share"] = profit_share
            row["fine_sum"] = fine_sum
            row["amount"] = base_salary + profit_share - fine_sum
            basis_parts = []
            if profit_share > 0 or fine_sum > 0:
                basis_parts.append(f"Часы × ставка: {format_money(base_salary)}")
            if profit_share > 0:
                basis_parts.append(f"доля прибыли: {format_money(profit_share)}")
            if fine_sum > 0:
                basis_parts.append(f"штраф: −{format_money(fine_sum)}")
            if basis_parts:
                row["basis"] = "; ".join(basis_parts)
            if parse_float(row.get("amount")) != 0 or parse_float(row.get("hours")) > 0 or fine_sum > 0:
                group_rows.append(row)
        group_rows.sort(key=lambda row: row["name"])
        hidden_groups.append({
            "visible_id": group["visible_id"],
            "visible_name": group["visible_name"],
            "rows": group_rows,
            "hidden_count": len(group_rows),
            "hours": sum(parse_float(row.get("hours")) for row in group_rows),
            "amount": sum(parse_float(row.get("amount")) for row in group_rows),
        })

    # Самые крупные выплаты показываем первыми. Нулевые остаются в списке,
    # но уходят вниз, чтобы не мешали искать реальные начисления.
    admin_rows.sort(key=lambda row: (parse_float(row.get("amount")), row.get("name", "")), reverse=True)
    visible_rows.sort(key=lambda row: (parse_float(row.get("amount")), row.get("name", "")), reverse=True)
    hidden_rows.sort(key=lambda row: row["name"])
    hidden_groups.sort(key=lambda group: group["visible_name"])

    sections = {
        "admins": admin_rows,
        "visible": visible_rows,
        "hidden": hidden_rows,
    }
    rows = sections[payout_type]

    hidden_payout_fee_total = sum(
        parse_float(stats.get("hidden_payout_fee", 0.0))
        for stats in visible_source_stats.values()
    )
    distribution_base_total = sum(
        parse_float(stats.get("net_profit", 0.0))
        for stats in visible_source_stats.values()
    )

    totals = {
        "all": sum(row.get("amount", 0.0) for row in admin_rows + visible_rows + hidden_rows),
        "admins": sum(row.get("amount", 0.0) for row in admin_rows),
        "visible": sum(row.get("amount", 0.0) for row in visible_rows),
        "hidden": sum(row.get("amount", 0.0) for row in hidden_rows),
    }

    # Нижние карточки должны показывать статусы оплат родителей, а не суммы
    # выплат сотрудникам. Считаем их отдельным проходом, чтобы они больше не
    # дублировали «Всего к выплате».
    payment_summary = build_payroll_payment_summary(filter_from, filter_to)

    if request.args.get("export") == "xlsx":
        workbook_buffer = build_payroll_workbook(
            admin_rows=admin_rows,
            visible_rows=visible_rows,
            hidden_rows=hidden_rows,
            hidden_groups=hidden_groups,
            totals=totals,
            period_caption=period_caption,
        )
        period_slug = (date_from or "vse") + "_" + (date_to or "vremya")
        return send_file(
            workbook_buffer,
            as_attachment=True,
            download_name=f"payroll_{period_slug}.xlsx",
            mimetype="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        )

    return render_template(
        "admin_payroll.html",
        title="Зарплаты",
        payout_type=payout_type,
        rows=rows,
        totals=totals,
        date_from=date_from,
        date_to=date_to,
        period_caption=period_caption,
        hidden_groups=hidden_groups,
        payment_summary=payment_summary,
        hidden_payout_fee_total=hidden_payout_fee_total,
        distribution_base_total=distribution_base_total,
        accountant_fee_grand_total=accountant_fee_grand_total,
    )


@app.route("/admin/finance/settings", methods=["POST"])
@login_required
@role_required("admin")
def admin_finance_settings():
    """Сохраняет распределение прибыли между админами и нескрытыми."""
    visible_tutors = (
        User.query
        .filter_by(role="tutor", is_hidden=False)
        .order_by(User.name.asc())
        .all()
    )
    hidden_tutors = (
        User.query
        .filter_by(role="tutor", is_hidden=True)
        .order_by(User.name.asc())
        .all()
    )

    recipients = [
        {"id": "admin_sanya", "name": "Саня"},
        {"id": "admin_seriy", "name": "Серый"},
        {"id": "admin_den", "name": "Дэн"},
    ]
    used_ids = {item["id"] for item in recipients}
    for user in visible_tutors + hidden_tutors:
        recipient_id = str(user.id)
        if recipient_id in used_ids:
            continue
        used_ids.add(recipient_id)
        recipients.append({"id": recipient_id, "name": user.name})

    allowed_recipient_ids = {item["id"] for item in recipients}

    admin_sources = [
        {"id": "admin_sanya", "name": "Саня"},
        {"id": "admin_seriy", "name": "Серый"},
        {"id": "admin_den", "name": "Дэн"},
    ]
    source_items = admin_sources + [{"id": str(user.id), "name": user.name, "user": user} for user in visible_tutors]

    for source_item in source_items:
        source_id = str(source_item["id"])
        source_name = source_item["name"]
        total_percent = 0.0
        values_by_recipient = {recipient["id"]: 0.0 for recipient in recipients}
        selected_recipients = request.form.getlist(f"profit_recipient_{source_id}[]")
        selected_percents = request.form.getlist(f"profit_percent_{source_id}[]")

        for recipient_id, percent_raw in zip(selected_recipients, selected_percents):
            recipient_id = str(recipient_id).strip()
            if recipient_id not in allowed_recipient_ids:
                continue
            percent = min(max(parse_float(percent_raw), 0.0), 100.0)
            if percent <= 0:
                continue
            values_by_recipient[recipient_id] = values_by_recipient.get(recipient_id, 0.0) + percent
            total_percent += percent

        # Пустая карточка разрешена: значит прибыль пока никуда не перенаправляется.
        # Если строки добавили, тогда сумма обязана быть 100%, иначе начинается
        # бухгалтерия уровня "кажется, деньги испарились".
        if selected_recipients and round(total_percent, 2) != 100.0:
            flash(
                f"У {source_name} сумма процентов должна быть ровно 100%.",
                "warning",
            )
            return redirect(url_for("admin_finance"))

        for recipient_id, percent in values_by_recipient.items():
            set_finance_setting(f"profit_share_{source_id}_{recipient_id}", percent)

        user = source_item.get("user")
        if user:
            user.admin_owner_key = None
            user.admin_owner_id = None
            if user.tutor_profile:
                user.tutor_profile.profit_percent = 0.0

    db.session.commit()
    flash("Настройки распределения прибыли сохранены.", "success")
    return redirect(url_for("admin_finance"))

