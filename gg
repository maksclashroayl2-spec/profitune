def get_hidden_tutor_id_for_week(week: Week) -> Optional[int]:
    """Определяет скрытого репетитора для недели.

    Сначала берём того, кто реально отправил отчёт. Если отчёт был одобрен
    или создан другим способом и поле пустое, используем назначение родителя
    к скрытому репетитору для пары родитель + нескрытый репетитор.
    """
    report = week.report

    if report and report.submitted_by_hidden_tutor_id:
        return report.submitted_by_hidden_tutor_id

    assignment = HiddenTutorAssignment.query.filter_by(
        parent_id=week.parent_id,
        visible_tutor_id=week.tutor_id,
    ).first()

    return assignment.hidden_tutor_id if assignment else None


def get_week_finance(week: Week) -> dict:
    report = week.report
    hours = get_report_hours(report)
    parent_hour_price = get_parent_hour_price(week.parent_id, week.tutor_id)
    hidden_tutor_id = get_hidden_tutor_id_for_week(week)
    hidden_hour_rate = get_hidden_hour_rate(
        week.tutor_id,
        hidden_tutor_id,
        hours,
    )

    parent_total = hours * parent_hour_price
    hidden_total = hours * hidden_hour_rate

    return {
        "hours": hours,
        "parent_hour_price": parent_hour_price,
        "parent_total": parent_total,
        "hidden_tutor_id": hidden_tutor_id,
        "hidden_hour_rate": hidden_hour_rate,
        "hidden_total": hidden_total,
        "profit": parent_total - hidden_total,
    }

