@app.route("/admin/user/<int:user_id>/delete")
@login_required
@role_required("admin")
def admin_delete_user(user_id: int):
    edited_user = db.session.get(User, user_id)

    if not edited_user:
        flash("Пользователь не найден.", "warning")
        return redirect(url_for("admin"))

    if edited_user.role == "admin":
        flash("Администратора нельзя удалить.", "warning")
        return redirect(url_for("admin"))

    # Удаляем профиль родителя
    ParentProfile.query.filter_by(
        user_id=edited_user.id
    ).delete(synchronize_session=False)

    # Удаляем заявки
    Booking.query.filter(
        (Booking.parent_id == edited_user.id)
        | (Booking.tutor_id == edited_user.id)
    ).delete(synchronize_session=False)

    # Удаляем назначения родителей репетиторам
    TutorAssignment.query.filter(
        (TutorAssignment.parent_id == edited_user.id)
        | (TutorAssignment.tutor_id == edited_user.id)
    ).delete(synchronize_session=False)

    # Удаляем назначения репетиторов
    HiddenTutorAssignment.query.filter(
        (HiddenTutorAssignment.parent_id == edited_user.id)
        | (HiddenTutorAssignment.visible_tutor_id == edited_user.id)
        | (HiddenTutorAssignment.hidden_tutor_id == edited_user.id)
    ).delete(synchronize_session=False)

    # Удаляем недели и отчёты
    weeks = Week.query.filter(
        (Week.parent_id == edited_user.id)
        | (Week.tutor_id == edited_user.id)
    ).all()

    for week in weeks:
        if week.report:
            for attachment in week.report.attachments:
                file_path = os.path.join(
                    REPORT_UPLOAD_DIR,
                    attachment.filename
                )

                if os.path.exists(file_path):
                    try:
                        os.remove(file_path)
                    except OSError:
                        pass

        db.session.delete(week)

    # Удаляем анкету репетитора
    if edited_user.tutor_profile:
        db.session.delete(edited_user.tutor_profile)

    db.session.delete(edited_user)
    db.session.commit()

    flash("Пользователь удалён.", "success")
    return redirect(url_for("admin"))


